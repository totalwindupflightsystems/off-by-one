#!/usr/bin/env node
// pi-agent — Off-by-One solve bridge (reference implementation).
//
// Implements the CLI contract off-by-one's solver expects:
//   pi-agent solve --problem-file P --output O --evidence E --signatures S --model M
//
// Reads the problem JSON, invokes the pi coding agent (earendil-works/pi,
// https://github.com/earendil-works/pi — install the release ELF or the
// npm package and point PI_BIN at it, default: next to this script, then
// ~/.local/lib/pi/pi, then /tmp/pi/pi, then the npm layout under
// $PI_HOME//tmp/pi/~/.local/share/pi/~/.pi) with the configured
// provider/model, and writes solution.md / evidence.md / signatures.json
// into the sandbox workspace.
//
// Runs INSIDE the bwrap sandbox: /usr, /lib*, /bin, /etc, $HOME/.local/bin,
// /tmp/pi and /run/systemd/resolve are ro-bind mounted, network is shared,
// env is inherited (OPENROUTER_API_KEY passes through from the server
// process).
//
// WHY SPAWN, NOT EXECFILE (field-tested 2026-08-15): pi blocks reading stdin
// until EOF when stdin is not a TTY, and it distinguishes a real pipe from
// /dev/null — stdin as a char device ('ignore') hangs it forever, while a
// real pipe that reaches EOF works. execFile's stdio handling (ignore/input)
// hangs pi at the full deadline; spawn + child.stdin.end() completes in
// seconds. Do not "simplify" this back to execFile.
//
// Also strips TLS env vars (SSL_CERT_FILE / CURL_CA_BUNDLE) that point at
// host-only paths (e.g. a Python venv certifi) — inside the bwrap sandbox
// those files don't exist and TLS fails with "error setting certificate
// file".
//
// Hardening folded in from the upstream issue #1 solver-chain work:
// $PI_MODEL verbatim override, placeholder-key detection (isUsableKey),
// provider env hygiene (the losing provider's key is dropped — pi resolves
// `deepseek/deepseek-v4-flash` by which key is present), --api-key
// propagation, and PI_CODING_AGENT_DIR isolation (a stale ~/.pi/agent
// store makes pi skip env-key auth for providers not in the store).

'use strict';
const fs = require('fs');
const path = require('path');
const os = require('os');
const { spawn } = require('child_process');

// --- arg parsing -----------------------------------------------------
function parseArgs(argv) {
  const opts = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const key = a.slice(2);
      const val = argv[i + 1];
      if (val !== undefined && !val.startsWith('--')) {
        opts[key] = val;
        i++;
      } else {
        opts[key] = true;
      }
    } else {
      opts._rest = opts._rest || [];
      opts._rest.push(a);
    }
  }
  return opts;
}

// --- model mapping ---------------------------------------------------
// The solver passes bare model IDs (solver.DefaultModel = deepseek-v4-flash).
// pi needs a provider-qualified model; map bare ids here. Add entries as
// needed for your provider.
const MODEL_MAP = {
  'deepseek-v4-flash': 'openrouter/deepseek/deepseek-v4-flash-0731',
};

/**
 * isUsableKey reports whether a key looks like a real provider key
 * rather than empty/placeholder content. Placeholder-shaped values
 * (like the ones in .env.example) must never steer model selection.
 */
function isUsableKey(value) {
  if (!value) return false;
  const k = String(value).trim();
  if (k.length < 20) return false;
  const lower = k.toLowerCase();
  const markers = ['your', 'changeme', 'change-me', 'placeholder', 'example', 'dummy', 'todo', 'insert'];
  return !markers.some((m) => lower.includes(m));
}

function resolveModel(m) {
  // $PI_MODEL wins verbatim (caller's override).
  if (process.env.PI_MODEL && process.env.PI_MODEL.trim() !== '') {
    return process.env.PI_MODEL.trim();
  }
  if (!m) return null;
  if (MODEL_MAP[m]) return MODEL_MAP[m];
  // Already provider-qualified (contains '/') → pass through.
  if (m.includes('/')) return m;
  return null;
}

// --- pi binary discovery ---------------------------------------------
// ELF installs first (matches the live lab layout), then the npm layout
// (packages/coding-agent/dist/cli.js under $PI_HOME//tmp/pi/home dirs).
function findPiBin() {
  const elfCandidates = [
    process.env.PI_BIN,
    path.join(__dirname, 'pi'),
    path.join(__dirname, '..', 'lib', 'pi', 'pi'),
    '/tmp/pi/pi',
  ].filter(Boolean);
  for (const c of elfCandidates) {
    // Regular-file check: a DIRECTORY named `pi` next to the wrapper
    // (e.g. the pi monorepo clone at /tmp/pi) must not match an ELF
    // candidate — spawn would fail with EACCES (PR #2 review hardening).
    let st = null;
    try {
      st = fs.statSync(c);
    } catch {
      /* missing — try next */
    }
    if (st && st.isFile()) return { bin: c, isJs: false };
  }
  const jsCandidates = [];
  if (process.env.PI_HOME && process.env.PI_HOME.trim() !== '') {
    jsCandidates.push(path.join(process.env.PI_HOME.trim(), 'packages', 'coding-agent', 'dist', 'cli.js'));
  }
  jsCandidates.push(path.join('/tmp/pi', 'packages', 'coding-agent', 'dist', 'cli.js'));
  try {
    jsCandidates.push(path.join(os.homedir(), '.local', 'share', 'pi', 'packages', 'coding-agent', 'dist', 'cli.js'));
    jsCandidates.push(path.join(os.homedir(), '.pi', 'packages', 'coding-agent', 'dist', 'cli.js'));
  } catch {
    /* homedir unavailable — skip home candidates */
  }
  for (const c of jsCandidates) {
    if (fs.existsSync(c)) return { bin: c, isJs: true };
  }
  return null;
}

// --- main ------------------------------------------------------------
function main() {
  const argv = process.argv.slice(2);
  const cmd = argv[0];

  if (cmd !== 'solve') {
    process.stderr.write(
      'pi-agent: off-by-one solve bridge\n' +
        'usage: pi-agent solve --problem-file P --output O [--evidence E] [--signatures S] [--model M] [--api-key K]\n' +
        'env:   OPENROUTER_API_KEY (required), PI_MODEL (optional override), PI_BIN / PI_HOME (pi install)\n'
    );
    process.exit(cmd ? 2 : 0);
  }

  const opts = parseArgs(argv.slice(1));

  const problemFile = opts['problem-file'];
  const outputFile = opts['output'];
  const evidenceFile = opts['evidence'];
  const signaturesFile = opts['signatures'];
  const modelArg = opts['model'] || 'deepseek-v4-flash';

  if (!problemFile || !outputFile) {
    process.stderr.write('pi-agent: --problem-file and --output are required\n');
    process.exit(2);
  }
  if (!fs.existsSync(problemFile)) {
    process.stderr.write(`pi-agent: problem file not found: ${problemFile}\n`);
    process.exit(2);
  }

  const problem = JSON.parse(fs.readFileSync(problemFile, 'utf8'));
  const model = resolveModel(modelArg);
  if (!model) {
    process.stderr.write(`pi-agent: cannot resolve model "${modelArg}" to a provider-qualified id\n`);
    process.exit(2);
  }

  // Key selection with placeholder detection: a placeholder-looking value
  // must never be treated as a real key.
  const envKeys = [process.env.OPENROUTER_API_KEY, process.env.LLM_API_KEY, process.env.DEEPSEEK_API_KEY];
  const usableKey = envKeys.find((k) => isUsableKey(k));
  if (opts['api-key']) {
    // --api-key wins over env.
    if (!isUsableKey(opts['api-key'])) {
      process.stderr.write('pi-agent: --api-key looks like a placeholder, refusing to use it\n');
      process.exit(2);
    }
  } else if (!usableKey) {
    process.stderr.write(
      'pi-agent: no usable API key (set OPENROUTER_API_KEY / LLM_API_KEY / DEEPSEEK_API_KEY)\n'
    );
    process.exit(2);
  }

  const piBin = findPiBin();
  if (!piBin) {
    process.stderr.write(
      'pi-agent: pi binary not found — install from https://github.com/earendil-works/pi/releases ' +
        '(ELF at /tmp/pi/pi or $PI_BIN, or clone the npm layout to /tmp/pi / $PI_HOME)\n'
    );
    process.exit(2);
  }

  // Build the solve prompt from the structured problem.
  const parts = [];
  parts.push(`# Problem class: ${problem.problem_class || 'unknown'}`);
  if (problem.environment) parts.push(`- Environment: ${problem.environment}`);
  if (problem.language) parts.push(`- Language: ${problem.language}`);
  if (problem.version) parts.push(`- Version: ${problem.version}`);
  if (problem.description) parts.push(`\n## Description\n${problem.description}`);
  if (problem.error_message) parts.push(`\n## Error message\n${problem.error_message}`);
  if (problem.stack_trace) parts.push(`\n## Stack trace / logs\n${problem.stack_trace}`);
  if (problem.context && typeof problem.context === 'object' && Object.keys(problem.context).length) {
    parts.push(`\n## Context\n${JSON.stringify(problem.context, null, 2)}`);
  }
  parts.push(
    '\n## Task\n' +
      'Diagnose this problem and produce a verified solution. Write the solution as markdown ' +
      'with a title, root-cause analysis, the exact fix (code or commands), and a verification ' +
      'section. Keep it self-contained and directly usable.'
  );
  const prompt = parts.join('\n');

  // --- env hygiene ---
  const piEnv = { ...process.env };
  delete piEnv.CURL_CA_BUNDLE;
  delete piEnv.SSL_CERT_FILE;

  if (opts['api-key']) {
    // Propagate the explicit key to every provider var pi could read.
    piEnv.OPENAI_API_KEY = opts['api-key'];
    if (model.includes('openrouter')) {
      piEnv.OPENROUTER_API_KEY = opts['api-key'];
    } else {
      piEnv.DEEPSEEK_API_KEY = opts['api-key'];
    }
  }
  // Provider env hygiene: `deepseek/deepseek-v4-flash` is registered under
  // BOTH the deepseek and openrouter registries — pi resolves by which key
  // is present, so the losing key must not leak into the sandbox env.
  if (model.includes('openrouter')) {
    delete piEnv.DEEPSEEK_API_KEY;
  } else if (model.startsWith('deepseek/')) {
    delete piEnv.OPENROUTER_API_KEY;
  }

  // PI_CODING_AGENT_DIR isolation: a stale ~/.pi/agent store (from ANY
  // prior pi usage, e.g. `pi login` for another provider) makes pi skip
  // env-key auth for providers not in the store — "No API key found for
  // deepseek" even with DEEPSEEK_API_KEY set. The bwrap sandbox never
  // hits this (clean HOME), so mirror that: point PI_CODING_AGENT_DIR at
  // a fresh temp dir unless the caller set it explicitly.
  if (!piEnv.PI_CODING_AGENT_DIR) {
    piEnv.PI_CODING_AGENT_DIR = path.join(
      os.tmpdir(),
      'pi-agent-' + (typeof process.getuid === 'function' ? process.getuid() : 'user')
    );
    try {
      fs.mkdirSync(piEnv.PI_CODING_AGENT_DIR, { recursive: true });
    } catch {
      /* non-fatal: pi falls back to the default dir */
    }
  }

  const deadlineMs = 25 * 60 * 1000; // under the server's 30m solve timeout

  const piArgs = ['--provider', 'openrouter', '--model', model, '--print', prompt];
  // npm-layout installs run under node; ELF installs run directly.
  const childBin = piBin.isJs ? process.execPath : piBin.bin;
  const childArgs = piBin.isJs ? [piBin.bin, ...piArgs] : piArgs;

  // spawn + immediate stdin EOF — see header comment, do NOT switch to
  // execFile (hangs pi forever).
  const child = spawn(childBin, childArgs, {
    env: piEnv,
    stdio: ['pipe', 'pipe', 'pipe'],
  });
  child.stdin.end();

  let stdout = '';
  let stderr = '';
  child.stdout.on('data', (d) => { stdout += d; });
  child.stderr.on('data', (d) => { stderr += d; });

  const timer = setTimeout(() => {
    child.kill('SIGKILL');
    process.stderr.write(`pi-agent: pi timed out after ${deadlineMs / 60000} min\n`);
    process.exit(1);
  }, deadlineMs);

  child.on('error', (err) => {
    clearTimeout(timer);
    process.stderr.write(`pi-agent: pi failed to start: ${err.message}\n`);
    process.exit(1);
  });

  child.on('close', (code, signal) => {
    clearTimeout(timer);
    if (code !== 0) {
      process.stderr.write(`pi-agent: pi exited ${signal ? 'with signal ' + signal : 'with code ' + code}\n`);
      if (stderr) process.stderr.write(String(stderr).slice(0, 2048) + '\n');
      process.exit(1);
    }

    const solution = String(stdout).trim() || '# Solution\n(pi returned no output)';

    fs.mkdirSync(path.dirname(outputFile), { recursive: true });
    fs.writeFileSync(outputFile, solution + '\n');

    if (evidenceFile) {
      fs.mkdirSync(path.dirname(evidenceFile), { recursive: true });
      fs.writeFileSync(evidenceFile,
        '# Evidence\n' +
        `- Problem class: ${problem.problem_class || 'unknown'}\n` +
        `- Model: ${model}\n` +
        `- Solved: ${new Date().toISOString()}\n` +
        '- Verification: solution produced by pi in sandbox; see signatures.json\n'
      );
    }

    if (signaturesFile) {
      fs.mkdirSync(path.dirname(signaturesFile), { recursive: true });
      fs.writeFileSync(signaturesFile, JSON.stringify({
        problem_class: problem.problem_class || 'unknown',
        description: problem.description || '',
        environment: problem.environment || '',
        language: problem.language || '',
        version: problem.version || '',
        model,
        provider: 'openrouter',
        solved_at: new Date().toISOString(),
      }, null, 2) + '\n');
    }

    process.stdout.write(`pi-agent: solved ${problem.problem_class} via ${model}\n`);
    process.exit(0);
  });
}

main();
