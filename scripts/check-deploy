#!/usr/bin/env bash
# check-deploy (OB-GAP-077) — one-command proof that the RUNNING
# off-by-one.service serves the code at HEAD.
#
# Legs, fail-fast; every failure exits non-zero with a named remedy:
#   1. make check-binary-fresh — the on-disk ./off-by-one artifact matches
#      HEAD's code paths (or byte-compares clean against a fresh build).
#   2. systemd unit off-by-one is running (MainPID non-empty, non-zero).
#   3. /proc/<MainPID>/exe IS this repo's artifact.
#   4. The RUNNING process's --version stamp resolves to a commit whose code
#      paths (cmd/ internal/ web/ sql/ pkg/ go.mod go.sum Makefile) match HEAD.
#      Data-only drift (corpus commits) is tolerated; code drift is not.
#   5. The running unit's effective ExecStart flags match the vendored deploy
#      contract deploy/off-by-one.service (DF-OFF-BY-ONE-29-R2). Legs 1-4 prove
#      the artifact; none of them reads the process's FLAGS — the repo can ship
#      a fix in the vendored unit while the host unit keeps the pre-fix
#      ExecStart (measured live 2026-10-20: -load-threshold -1 and no
#      -solve-mem-mb, 16 days after the rows closed). A fresh artifact running
#      pre-fix flags is still a failed deploy. Drift fails with
#      expected-vs-observed per flag; an intentional host deviation is recorded
#      by editing BOTH the vendored unit and the host unit (with a comment),
#      never by leaving them silently apart.
#
# Unit-testable seams (touch neither systemctl nor /proc):
#   scripts/check-deploy --resolve-stamp <stamp>
#     exit 0 — resolvable stamp whose code paths match HEAD
#     exit 1 — divergence, dirty stamp, or unparseable stamp
#   scripts/check-deploy --check-flags <contract-unit-file> <execstart-value>
#     exit 0 — the running unit's flags match the vendored contract
#     exit 1 — drift (expected-vs-observed printed per flag) or an
#              unparseable/flagless contract
#     <execstart-value> is what `systemctl show <unit> -p ExecStart --value`
#     prints; both the structured form ({ path=... ; argv[]=... ; ... }) and a
#     plain command line are accepted, and systemd quoting/binary-path
#     formatting is normalized away so only real flag drift fails.
#
# Docs: docs/dogfood/diagnostics.md → "Deploy check after any code commit".
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
UNIT="off-by-one"
ARTIFACT="$REPO_ROOT/off-by-one"

# Stamp-resolution semantics mirror Makefile's check-binary-fresh:
#   *-dirty           → named failure (built from a dirty tree)
#   ...-g<rev> forms  → candidate = text after the last "-g"
#   <a>-<b>-<c> forms → candidate = last hyphen-separated field
#   anything else     → candidate = the stamp itself
# A resolvable candidate PASSES only when the code-path diff against HEAD is
# empty (`git diff --name-only <rev> -- cmd/ internal/ web/ sql/ pkg/ go.mod
# go.sum Makefile`). Unresolvable stamps fail here by name — this seam has no
# byte-compare leg (default mode's leg 1 covers that for the on-disk artifact).
resolve_stamp() {
	local stamp="$1"
	local candidate

	case "$stamp" in
	*-dirty)
		echo "FAIL: stamp '$stamp' was built from a dirty tree — the working tree had uncommitted changes when it was compiled; commit or stash them, then run 'make build'"
		return 1
		;;
	esac

	case "$stamp" in
	*-*-g?* | *-g?*) candidate="${stamp##*-g}" ;;
	*-*-?*) candidate="${stamp##*-}" ;;
	*) candidate="$stamp" ;;
	esac

	if git rev-parse --verify --quiet "${candidate}^{commit}" >/dev/null 2>&1; then
		local rev
		rev="$(git rev-parse --short "$candidate")"
		local changed git_rc attempt
		# Concurrent git processes on this repo (guards, board ticks) can make a
		# single diff call fail transiently; retry once before failing the check.
		changed=""
		git_rc=1
		for attempt in 1 2; do
			if changed="$(git diff --name-only "$rev" -- cmd/ internal/ web/ sql/ pkg/ go.mod go.sum 2>/dev/null)"; then
				git_rc=0
				break
			fi
			sleep 1
		done
		if [ "$git_rc" -ne 0 ]; then
			echo "FAIL: 'git diff --name-only $rev -- <code paths>' failed (rc=$git_rc) twice — a concurrent git process may hold the repo; retry check-deploy"
			return 1
		fi
		if [ -z "$changed" ]; then
			echo "PASS: stamp '$stamp' resolves to $rev — code paths match HEAD (data-only drift tolerated)"
			return 0
		fi
		echo "FAIL: stamp '$stamp' resolves to $rev, but HEAD's code paths changed since it:"
		echo "$changed"
		echo "remedy: run 'make build' to rebuild the artifact, relaunch the service (systemd Restart=always re-executes it on kill), then re-run check-deploy"
		return 1
	fi

	echo "FAIL: stamp '$stamp' does not name a resolvable commit (candidate '$candidate') — rebuild with 'make build' and relaunch the service, then re-run check-deploy"
	return 1
}

# --- Flag contract (leg 5, DF-OFF-BY-ONE-29-R2) ------------------------------
# The vendored unit deploy/off-by-one.service is the daemon flag contract; the
# running unit's effective ExecStart argv must carry the same flags. The binary
# path (leg 3's evidence) and systemd quoting are normalized away so only real
# flag drift fails.

# Print the vendored unit's daemon flags: the ExecStart line minus the binary
# path, whitespace-collapsed.
contract_flags() {
	local unit_file="$1"
	sed -n 's/^ExecStart=[^[:space:]]*[[:space:]]*//p' "$unit_file" | head -1
}

# Print a running unit's daemon flags from its ExecStart property value.
# Accepts systemctl's structured form
#   { path=/x/off-by-one ; argv[]=/x/off-by-one --port 8766 ... ; ... }
# and a plain command line alike; strips the binary path (first token).
running_flags() {
	local execstart="$1" argv
	case "$execstart" in
	\{*argv\[\]=*)
		# Flag values for this daemon never contain ';', so the first ';'
		# after argv[]= terminates the flag list.
		argv="$(printf '%s\n' "$execstart" | sed -n 's/.*argv\[\]=\([^;]*\);.*/\1/p' | head -1)"
		;;
	*)
		argv="$execstart"
		;;
	esac
	printf '%s\n' "$argv" | sed 's/^[^[:space:]]*[[:space:]]*//'
}

# Collapse whitespace and strip one layer of surrounding quotes per token, so
# systemd's quoting of the same argument is never reported as drift.
normalize_flags() {
	local raw="$1" tok out=""
	local -a toks=()
	read -r -a toks <<<"$raw"
	for tok in ${toks[@]+"${toks[@]}"}; do
		tok="${tok%\"}"
		tok="${tok#\"}"
		tok="${tok%\'}"
		tok="${tok#\'}"
		out="${out}${out:+ }${tok}"
	done
	printf '%s\n' "$out"
}

# Print expected-vs-observed for every drifted flag. A token starts a new flag
# when it looks like -x/--word; a negative NUMBER (-1) stays a value, so
# '-load-threshold -1' parses as load-threshold=-1.
report_flag_drift() {
	local want="$1" have="$2"
	local -A want_map=() have_map=()
	local -a want_order=() toks=()
	local tok cur k
	cur=""
	read -r -a toks <<<"$want"
	for tok in ${toks[@]+"${toks[@]}"}; do
		if [[ $tok =~ ^--?[a-zA-Z] ]]; then
			cur="$tok"
			want_map["$cur"]=""
			want_order+=("$cur")
		elif [ -n "$cur" ]; then
			want_map["$cur"]="${want_map[$cur]}${want_map[$cur]:+ }$tok"
		fi
	done
	cur=""
	read -r -a toks <<<"$have"
	for tok in ${toks[@]+"${toks[@]}"}; do
		if [[ $tok =~ ^--?[a-zA-Z] ]]; then
			cur="$tok"
			have_map["$cur"]=""
		elif [ -n "$cur" ]; then
			have_map["$cur"]="${have_map[$cur]}${have_map[$cur]:+ }$tok"
		fi
	done
	for k in ${want_order[@]+"${want_order[@]}"}; do
		if [ -z "${have_map[$k]+x}" ]; then
			printf '  %s: expected %s, observed <absent>\n' "$k" "${want_map[$k]:-<none>}"
		elif [ "${want_map[$k]}" != "${have_map[$k]}" ]; then
			printf '  %s: expected %s, observed %s\n' "$k" "${want_map[$k]:-<none>}" "${have_map[$k]:-<none>}"
		fi
	done
	for k in "${!have_map[@]}"; do
		if [ -z "${want_map[$k]+x}" ]; then
			printf '  %s: not in contract, observed %s\n' "$k" "${have_map[$k]:-<none>}"
		fi
	done
	printf '  contract flags: %s\n' "$want"
	printf '  observed flags: %s\n' "$have"
}

# exit 0 — running flags match the contract; exit 1 — drift or no contract.
check_flag_contract() {
	local contract_file="$1" execstart="$2"
	local want have
	if [ ! -f "$contract_file" ]; then
		echo "FAIL: deploy contract $contract_file is missing — the running unit's flags cannot be verified (restore it: git checkout -- deploy/off-by-one.service)"
		return 1
	fi
	want="$(normalize_flags "$(contract_flags "$contract_file")")"
	have="$(normalize_flags "$(running_flags "$execstart")")"
	if [ -z "$want" ]; then
		echo "FAIL: $contract_file carries no daemon flags to contract against (its ExecStart has no arguments?)"
		return 1
	fi
	if [ "$want" = "$have" ]; then
		echo "PASS: running unit's ExecStart flags match $contract_file"
		return 0
	fi
	echo "FAIL: running unit's ExecStart flags drifted from $contract_file:"
	report_flag_drift "$want" "$have"
	return 1
}

main() {
	cd "$REPO_ROOT"

	# Leg 1: on-disk artifact freshness (chains make check-binary-fresh).
	if ! make check-binary-fresh; then
		echo "check-deploy: FAIL — leg 1: make check-binary-fresh rejected ./off-by-one (see ERROR above)"
		echo "remedy: commit or stash the working tree if needed, then run 'make build', relaunch the service, and re-run make check-deploy"
		exit 1
	fi

	# Leg 2: the service must be running.
	pid="$(systemctl show "$UNIT" -p MainPID --value 2>/dev/null || true)"
	if [ -z "$pid" ] || [ "$pid" = "0" ]; then
		echo "check-deploy: FAIL — leg 2: unit $UNIT not running (MainPID empty/0)"
		echo "remedy: start the service, then re-run make check-deploy"
		exit 1
	fi

	# Leg 3: the running process must BE the repo artifact.
	exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
	if [ -z "$exe" ]; then
		echo "check-deploy: FAIL — leg 3: cannot read /proc/$pid/exe (process exited between legs?)"
		echo "remedy: re-run make check-deploy"
		exit 1
	fi
	artifact_path="$(realpath "$ARTIFACT" 2>/dev/null || true)"
	if [ -z "$artifact_path" ] || [ "$exe" != "$artifact_path" ]; then
		echo "check-deploy: FAIL — leg 3: running process (pid $pid) executes '$exe', not the repo artifact '$ARTIFACT'"
		echo "remedy: rebuild from this repo ('make build') and relaunch the service so /proc/<MainPID>/exe points at $ARTIFACT, then re-run make check-deploy"
		exit 1
	fi

	# Leg 4: the RUNNING binary's stamp must serve HEAD's code paths.
	raw_version="$("$exe" --version 2>/dev/null || true)"
	stamp="$(printf '%s\n' "$raw_version" | awk '{print $NF}')"
	if [ -z "$stamp" ]; then
		echo "check-deploy: FAIL — leg 4: '$exe' produced no --version stamp"
		echo "remedy: run 'make build' and relaunch the service, then re-run make check-deploy"
		exit 1
	fi
	if ! resolve_stamp "$stamp"; then
		echo "check-deploy: FAIL — leg 4: running service (pid $pid, stamp $stamp) does not serve HEAD's code"
		echo "remedy: cd $REPO_ROOT && make build && kill $pid  # systemd Restart=always relaunches the service; re-run make check-deploy"
		exit 1
	fi

	# Leg 5: the running unit's ExecStart flags must match the vendored deploy
	# contract — a fresh artifact running pre-fix flags is still a failed
	# deploy (DF-OFF-BY-ONE-29-R2).
	running_execstart="$(systemctl show "$UNIT" -p ExecStart --value 2>/dev/null || true)"
	if check_flag_contract "$REPO_ROOT/deploy/off-by-one.service" "$running_execstart"; then
		echo "check-deploy: PASS — running service (pid $pid, stamp $stamp) serves HEAD's code under the contracted flags"
	else
		echo "check-deploy: FAIL — leg 5: running unit (pid $pid) ExecStart flags drifted from deploy/off-by-one.service"
		echo "remedy: install -m 0644 deploy/off-by-one.service /etc/systemd/system/off-by-one.service && systemctl daemon-reload && systemctl restart off-by-one — or, for an intentional deviation, record it in BOTH the host unit and the vendored copy, then re-run make check-deploy"
		exit 1
	fi
}

case "${1:-}" in
--resolve-stamp)
	[ "$#" -eq 2 ] || {
		echo "usage: $0 --resolve-stamp <stamp>" >&2
		exit 2
	}
	cd "$REPO_ROOT"
	if resolve_stamp "$2"; then
		exit 0
	else
		exit 1
	fi
	;;
--check-flags)
	[ "$#" -eq 3 ] || {
		echo "usage: $0 --check-flags <contract-unit-file> <execstart-value>" >&2
		exit 2
	}
	if check_flag_contract "$2" "$3"; then
		exit 0
	else
		exit 1
	fi
	;;
"")
	main
	;;
*)
	echo "usage: $0 [--resolve-stamp <stamp> | --check-flags <contract-unit-file> <execstart-value>]" >&2
	exit 2
	;;
esac
