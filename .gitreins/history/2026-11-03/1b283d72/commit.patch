+<td>✅</td>
+</tr>
+<tr>
+<td><code>rebase-merge/</code> present</td>
+<td><code>ACTIVE</code> / exit 3</td>
+<td>✅</td>
+</tr>
+<tr>
+<td>Live <code>git rebase --continue</code> in tree</td>
+<td><code>ACTIVE</code> / exit 3</td>
+<td>✅</td>
+</tr>
+<tr>
+<td>No <code>rebase (finish)</code></td>
+<td><code>INDETERMINATE</code> / exit 4</td>
+<td>✅</td>
+</tr>
+<tr>
+<td>No warmer hook</td>
+<td>cache not attributed</td>
+<td>✅</td>
+</tr>
+<tr>
+<td><code>git add -f</code> a cache file</td>
+<td><code>tracked=true, staged=true</code></td>
+<td>✅</td>
