 then\n  echo \"ERROR: tree mismatch: $NEW_TREE != $TREE\" >&2\n  exit 1\nfi\n\ngit tag -a \"$NEW_TAG\" \"$NEW_SHA\" -m \"Release $NEW_TAG (tree-identical to $TARGET)\"\nprintf 'target_sha=%s\\nnew_sha=%s\\ntree=%s\\nnew_tag=%s\\n' \"$TARGET\" \"$NEW_SHA\" \"$TREE\" \"$NEW_TAG\"\n\nif [ \"$PUSH\" = 1 ]; then\n  git push \"$REMOTE\" \"refs/tags/$NEW_TAG\"\nfi\n```\n\n### `ci-tag-proof.sh`\n\n````bash\n#!/usr/bin/env bash\nset -euo pipefail\n\nSKIP_RE='\\[(skip[[:space:]-]?ci|ci[[:space:]-]?skip|no[[:space:]-]?ci|skip[[:space:]-]?actions|actions[[:space:]-]?skip)\\]'\nREPO=${REPO:-}\nREF=${1:?usage: REPO=owner/repo $0 <tag-or-sha> [tag-name]}\nTAG=${2:-$REF}\nTARGET=$(git rev-parse --verify \"$REF^{commit}\")\nOUT=${OUT:-ci-coverage-finding-${TAG//\\//_}.md}\n\n{\n  echo \"# CI coverage finding: ${REPO:-<repo>} $TAG\"\n  echo\n  echo \"- Tag: \\`$TAG\\`\"\n  echo \"- Commit: \\`$TARGET\\`\"\n  echo \"- Subject: $(git log -1 --format=%s \"$TARGET\")\"\n  if git log -1 --format=%B \"$TARGET\" | grep -Eiq \"$SKIP_RE\"; then\n    echo \"- Skip marker: **present**\"\n  else\n    echo \"- Skip marker: absent\"\n  fi\n  echo\n  echo '## Commit message'\n  echo '```'\n  git log -1 --format='%H%n%an <%ae>%n%ad%n%n%B' \"$TARGET\"\n  echo '```'\n  echo\n  echo '## Workflow triggers at this SHA'\n  echo '```'\n  mapfile -t WF < <(git ls-tree -r --name-only \"$TARGET\" .github/workflows 2>/dev/null | grep -E '\\.ya?ml$' || true)\n  if [ ${#WF[@]} -eq 0 ]; then\n    echo '(no workflow files)'\n  else\n    for f in \"${WF[@]}\"; do\n      echo \"--- $f\"\n      git show \"$TARGET:$f\" | awk '/^on:/{inon=1;print;next} inon && /^[^[:space:]#]/{inon=0} inon{print}' | head -60\n    done\n  fi\n  echo '```'\n  echo\n  echo '## GitHub Actions runs for this SHA'\n  echo '```json'\n  if [ -n \"$REPO\" ] && command -v gh >/dev/null 2>&1; then\n    gh api \"repos/$REPO/actions/runs?head_sha=$TARGET&per_page=100\" --jq '{total_count, runs: [.workflow_runs[] | {id,name,event,head_branch,status,conclusion,html_url}]}' 2>/dev/null || echo '{\"error\":\"gh query failed\"}'\n  else\n    echo '{\"error\":\"REPO not set or gh unavailable\"}'\n  fi\n  echo '```'\n  echo\n  echo '## Check runs for this SHA'\n  echo '```json'\n  if [ -n \"$REPO\" ] && command -v gh >/dev/null 2>&1; then\n    gh api \"repos/$REPO/commits/$TARGET/check-runs\" --jq '{total_count, check_runs: [.check_runs[] | {name,status,conclusion}]}' 2>/dev/null || echo '{\"error\":\"gh query failed\"}'\n  else\n    echo '{\"error\":\"REPO not set or gh unavailable\"}'\n  fi\n  echo '```'\n  echo\n  echo '## Conclusion'\n  echo\n  echo 'The tag landed, but GitHub Actions cannot create a run for this SHA because the commit message contains a GitHub Actions skip marker and no alternative trigger exists. This is an impossibility proof, not a CI failure.'\n} > \"$OUT\"\n\necho \"wrote $OUT\"\n````\n\n### `test-ci-tag-fix.sh`\n\n```bash\n#!/usr/bin/env bash\nset -euo pipefail\n\nSCRIPT_DIR=$(cd -- \"$(dirname -- \"${BASH_SOURCE[0]}\")\" && pwd)\nFIX=${FIX:-\"$SCRIPT_DIR/ci-tag-fix.sh\"}\nSKIP_RE='\\[(skip[[:space:]-]?ci|ci[[:space:]-]?skip|no[[:space:]-]?ci|skip[[:space:]-]?actions|actions[[:space:]-]?skip)\\]'\nTMP=$(mktemp -d)\ntrap 'rm -rf \"$TMP\"' EXIT\ncd \"$TMP\"\ngit init -q\ngit config user.email <email>\ngit config user.name Test\necho a > a.txt\ngit add a.txt\ngit commit -q -m \"initial\"\necho b >> a.txt\ngit commit -qam \"release prep [ci skip]\"\nTARGET=$(git rev-parse HEAD)\nTARGET_TREE=$(git rev-parse \"$TARGET^{tree}\")\n\"$FIX\" \"$TARGET\" v1.0.0-tree >/dev/null\nNEW=$(git rev-parse 'v1.0.0-tree^{commit}')\nNEW_TREE=$(git rev-parse \"$NEW^{tree}\")\n[ \"$TARGET_TREE\" = \"$NEW_TREE\" ] || { echo \"FAIL: tree mismatch\"; exit 1; }\nif git log -1 --format=%B \"$NEW\" | grep -Eiq \"$SKIP_RE\"; then\n  echo \"FAIL: new commit still has a skip marker\"; exit 1\nfi\necho \"PASS\"\necho \"target=$TARGET\"\necho \"new=$NEW\"\necho \"tree=$TARGET_TREE\"\necho \"new_subject=$(git log -1 --format=%s \"$NEW\")\"\n```\n", "evidence": "# Evidence\n- Problem class: github-actions-tag-push-no-run-ci-skip\n- Model: openrouter/deepseek/deepseek-v4.1-flash\n- Solved: 2026-11-02T07:29:54.060Z\n- Verification: solution produced by pi in sandbox; see signatures.json\n", "signatures": {"description": "PROBLEM: pushing a probe tag (or any tag) at a commit whose message contains [ci skip]/[skip ci]/[no ci]/[skip actions]/[actions skip] creates NO GitHub Actions run, and no override exists for tag pushes (GitHub changelog 2021-02-08: markers skip workflows triggered on push AND pull_request events; community discussion #179637 confirms tag pushes cannot ignore the marker). Symptom: git ls-remote shows the tag landed, workflow trigger matches (on.push.tags: [v*]), GitHub status operational, but actions/runs?head_sha=<sha> stays total_count=0 forever and a bounded poll never sees a run. DIAGNOSIS (controlled comparison in <project> 2026-11-01): probe tag v1.0.0-ci-probe-20261025-1416 at skip-free c4043b0c fired run 40202677040 (success); v1.0.0 and v1.0.0-ci-probe-20261101-1231 at fdcec4c (message ends '...log entry [ci skip]') produced zero runs. CHECK FIRST before designing any tag-push CI-evidence strategy: git log -1 --format=%s <target-sha> for skip markers; then inventory triggers (workflow_dispatch/schedule/repository_dispatch absent = no other GitHub event can cover the sha; re-run requires an existing run; PR events also die on the HEAD commit marker). FIX/WORKAROUNDS: (a) run the exact workflow locally with act at the exact sha (repos may ship an act-parity container image), (b) fire CI at a tree-identical commit without the skip marker and cite tree equivalence via git rev-parse <sha>^{tree}, (c) if a release tag already points at a skip-marked commit, the impossibility proof IS the coverage finding. PREVENTION: never cut release tags from [ci skip] bookkeeping/log commits.", "environment": "", "language": "", "model": "openrouter/deepseek/deepseek-v4.1-flash", 