m.next = b.next\n\t} else {\n\t\tm.leftmost = a.leftmost\n\t\t// Insert the separator between the two cell runs.\n\t\tmid := append([]cell(nil), a.cells...)\n\t\tmid = append(mid, cell{key: append([]byte(nil), sep.key...), child: b.leftmost})\n\t\tmid = append(mid, b.cells...)\n\t\tm.cells = mid\n\t}\n\tif !fits(m) {\n\t\treturn nil, false\n\t}\n\treturn m, true\n}\n\nfunc (t *BTree) doMerge(into, merged *page) error {\n\tinto.cells = merged.cells\n\tinto.next = merged.next\n\tinto.leftmost = merged.leftmost\n\treturn t.stage(into)\n}\n\nfunc (t *BTree) redistributeRight(p *page, ci int, child, r *page) {\n\tif child.typ == pageTypeLeaf {\n\t\tfor usedBytes(child) < minFill && len(r.cells) > 1 {\n\t\t\tc := r.cells[0]\n\t\t\tr.cells = r.cells[1:]\n\t\t\tchild.cells = append(child.cells, c)\n\t\t}\n\t\tif len(r.cells) > 0 {\n\t\t\tp.cells[ci].key = append([]byte(nil), r.cells[0].key...)\n\t\t}\n\t\t_ = t.stage(child)\n\t\t_ = t.stage(r)\n\t\treturn\n\t}\n\t// Interior rotation: parent separator moves down, right's first key moves up.\n\tfor usedBytes(child) < minFill && len(r.cells) > 0 {\n\t\tsep := p.cells[ci]\n\t\trFirst := r.cells[0]\n\t\toldChild, oldRCells, oldRLeft, oldPCell := clonePage(child), append([]cell(nil), r.cells...), r.leftmost, p.cells[ci]\n\n\t\tchild.cells = append(child.cells, cell{key: append([]byte(nil), sep.key...), child: r.leftmost})\n\t\tp.cells[ci] = cell{key: append([]byte(nil), rFirst.key...), child: rFirst.child}\n\t\tr.leftmost = rFirst.child\n\t\tr.cells = r.cells[1:]\n\t\tif !fits(child) || !fits(r) {\n\t\t\t// revert\n\t\t\tchild.cells, child.leftmost = oldChild.cells, oldChild.leftmost\n\t\t\tr.cells, r.leftmost = oldRCells, oldRLeft\n\t\t\tp.cells[ci] = oldPCell\n\t\t\tbreak\n\t\t}\n\t}\n\t_ = t.stage(child)\n\t_ = t.stage(r)\n}\n\nfunc (t *BTree) redistributeLeft(p *page, ci int, l, child *page) {\n\tif child.typ == pageTypeLeaf {\n\t\tfor usedBytes(child) < minFill && len(l.cells) > 1 {\n\t\t\tc := l.cells[len(l.cells)-1]\n\t\t\tl.cells = l.cells[:len(l.cells)-1]\n\t\t\tchild.cells = append([]cell{c}, child.cells...)\n\t\t}\n\t\tif len(child.cells) > 0 {\n\t\t\tp.cells[ci-1].key = append([]byte(nil), child.cells[0].key...)\n\t\t}\n\t\t_ = t.stage(child)\n\t\t_ = t.stage(l)\n\t\treturn\n\t}\n\tfor usedBytes(child) < minFill && len(l.cells) > 0 {\n\t\tsep := p.cells[ci-1]\n\t\tlast := l.cells[len(l.cells)-1]\n\t\toldChild, oldLCells, oldLLeft, oldPCell := clonePage(child), append([]cell(nil), l.cells...), l.leftmost, p.cells[ci-1]\n\n\t\tchild.cells = append([]cell{{key: append([]byte(nil), sep.key...), child: child.leftmost}}, child.cells...)\n\t\tchild.leftmost = last.child\n\t\tp.cells[ci-1] = cell{key: append([]byte(nil), last.key...), child: sep.child}\n\t\tl.cells = l.cells[:len(l.cells)-1]\n\t\tif !fits(child) || !fits(l) {\n\t\t\tchild.cells, child.leftmost = oldChild.cells, oldChild.leftmost\n\t\t\tl.cells, l.leftmost = oldLCells, oldLLeft\n\t\t\tp.cells[ci-1] = oldPCell\n\t\t\tbreak\n\t\t}\n\t}\n\t_ = t.stage(child)\n\t_ = t.stage(l)\n}\n\nfunc clonePage(p *page) *page {\n\tq := *p\n\tq.cells = append([]cell(nil), p.cells...)\n\treturn &q\n}\n\n// ---------------- Scan / Get ----------------\n\nfunc (t *BTree) Get(key []byte) ([]byte, bool) {\n\tid := t.root\n\tfor {\n\t\tp := t.load(id)\n\t\tif p.typ == pageTypeLeaf {\n\t\t\ti := sort.Search(len(p.cells), func(i int) bool {\n\t\t\t\treturn bytes.Compare(p.cells[i].key, key) >= 0\n\t\t\t})\n\t\t\tif i < len(p.cells) && bytes.Equal(p.cells[i].key, key) {\n\t\t\t\treturn append([]byte(nil), p.cells[i].val...), true\n\t\t\t}\n\t\t\treturn nil, false\n\t\t}\n\t\tid = childAt(p, childIndexOf(p, key))\n\t}\n}\n\nfunc (t *BTree) Scan(fn func(k, v []byte) bool) {\n\tid := t.root\n\tfor {\n\t\tp := t.load(id)\n\t\tif p.typ == pageTypeLeaf {\n\t\t\tbreak\n\t\t}\n\t\tid = p.leftmost\n\t}\n\tfor id != 0 {\n\t\tp := t.load(id)\n\t\tfor _, c := range p.cells {\n\t\t\tif !fn(c.key, c.val) {\n\t\t\t\treturn\n\t\t\t}\n\t\t}\n\t\tid = p.next\n\t}\n}\n```\n\n### `btree_test.go`\n\n```go\npackage btree\n\nimport (\n\t\"bytes\"\n\t\"fmt\"\n\t\"math/rand\"\n\t\"sort\"\n\t\"testing\"\n)\n\nfunc TestRandomWorkload(t *testing.T) {\n\tpager := NewMemPager()\n\twal := NewWAL()\n\tb, err := New(pager, wal)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\trng := rand.New(rand.NewSource(42))\n\toracle := map[string]string{}\n\n\tkeyAt := func() string {\n\t\tn := 1 + rng.Intn(16)\n\t\tbuf := make([]byte, n)\n\t\tfor i := range buf {\n\t\t\tbuf[i] = byte('a' + rng.Intn(26))\n\t\t}\n\t\treturn string(buf)\n\t}\n\tvalAt := func() string {\n\t\tn := rng.Intn(41)\n\t\tbuf := make([]byte, n)\n\t\tfor i := range buf {\n\t\t\tbuf[i] = byte('A' + rng.Intn(26))\n\t\t}\n\t\treturn string(buf)\n\t}\n\n\tconst ops = 6000\n\tfor i := 0; i < ops; i++ {\n\t\tk := keyAt()\n\t\tif rng.Intn(100) < 70 {\n\t\t\tv := valAt()\n\t\t\tif err := b.Put([]byte(k), []byte(v)); err != nil {\n\t\t\t\tt.Fatalf(\"op %d put %q: %v\", i, k, err)\n\t\t\t}\n\t\t\toracle[k] = v\n\t\t} else {\n\t\t\tif err := b.Delete([]byte(k)); err != nil {\n\t\t\t\tt.Fatalf(\"op %d delete %q: %v\", i, k, err)\n\t\t\t}\n\t\t\tdelete(oracle, k)\n\t\t}\n\t\tif i%25 == 0 {\n\t\t\tcheckAll(t, b, oracle)\n\t\t}\n\t}\n\tcheckAll(t, b, oracle)\n\tt.Logf(\"final pages reachable: %d\", len(reachable(b)))\n}\n\nfunc TestManySeeds(t *testing.T) {\n\tfor seed := int64(1); seed <= 25; seed++ {\n\t\tpager := NewMemPager()\n\t\tb, err := New(pager, NewWAL())\n\t\tif err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\trng := rand.New(rand.NewSource(seed))\n\t\toracle := map[string]string{}\n\t\tfor i := 0; i < 4000; i++ {\n\t\t\tn := 1 + rng.Intn(20)\n\t\t\tkb := make([]byte, n)\n\t\t\tfor j := range kb {\n\t\t\t\tkb[j] = byte('a' + rng.Intn(8))\n\t\t\t}\n\t\t\tk := string(kb)\n\t\t\tif rng.Intn(100) < 65 {\n\t\t\t\tvb := make([]byte, rng.Intn(120))\n\t\t\t\tfor j := range vb {\n\t\t\t\t\tvb[j] = byte('A' + rng.Intn(26))\n\t\t\t\t}\n\t\t\t\tv := string(vb)\n\t\t\t\tif err := b.Put([]byte(k), []byte(v)); err != nil {\n\t\t\t\t\tt.Fatalf(\"seed %d op %d put: %v\", seed, i, err)\n\t\t\t\t}\n\t\t\t\toracle[k] = v\n\t\t\t} else {\n\t\t\t\tif err := b.Delete([]byte(k)); err != nil {\n\t\t\t\t\tt.Fatalf(\"seed %d op %d del: %v\", seed, i, err)\n\t\t\t\t}\n\t\t\t\tdelete(oracle, k)\n\t\t\t}\n\t\t\tif i%50 == 0 {\n\t\t\t\tcheckAll(t, b, oracle)\n\t\t\t}\n\t\t}\n\t\tcheckAll(t, b, oracle)\n\t}\n}\n\nfunc TestLargeKeysAndValues(t *testing.T) {\n\tpager := NewMemPager()\n\tb, _ := New(pager, NewWAL())\n\trng := rand.New(rand.NewSource(7))\n\toracle := map[string]string{}\n\tfor i := 0; i < 2000; i++ {\n\t\tk := fmt.Sprintf(\"key-%08d-%s\", rng.Intn(100000), string(rune('a'+rng.Intn(26))))\n\t\tswitch rng.Intn(4) {\n\t\tcase 0, 1, 2:\n\t\t\tv := string(bytes.Repeat([]byte{byte('x' + rng.Intn(3))}, 1+rng.Intn(200)))\n\t\t\tif err := b.Put([]byte(k), []byte(v)); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\toracle[k] = v\n\t\tdefault:\n\t\t\tif err := b.Delete([]byte(k)); err != nil {\n\t\t\t\tt.Fatal(err)\n\t\t\t}\n\t\t\tdelete(oracle, k)\n\t\t}\n\t}\n\tcheckAll(t, b, oracle)\n}\n\nfunc TestFilePagerRoundTrip(t *testing.T) {\n\tdir := t.TempDir()\n\tfp, err := OpenFilePager(dir + \"/db.btree\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\twal := NewWAL()\n\tb, err := New(fp, wal)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\toracle := map[string]string{}\n\tfor i := 0; i < 500; i++ {\n\t\tk := fmt.Sprintf(\"k%04d\", i)\n\t\tv := fmt.Sprintf(\"v%04d\", i)\n\t\tif err := b.Put([]byte(k), []byte(v)); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\toracle[k] = v\n\t}\n\tif err := fp.Sync(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tif err := fp.Close(); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tfp2, err := OpenFilePager(dir + \"/db.btree\")\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tdefer fp2.Close()\n\tb2, err := New(fp2, wal)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcheckAll(t, b2, oracle)\n}\n\nfunc TestCrashRecoveryIdempotent(t *testing.T) {\n\tpager := NewMemPager()\n\twal := NewWAL()\n\tb, err := New(pager, wal)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\toracle := map[string]string{}\n\tfor i := 0; i < 400; i++ {\n\t\tk := fmt.Sprintf(\"k%04d\", i)\n\t\tv := fmt.Sprintf(\"v%04d\", i*7)\n\t\tif err := b.Put([]byte(k), []byte(v)); err != nil {\n\t\t\tt.Fatal(err)\n\t\t}\n\t\toracle[k] = v\n\t}\n\t// Simulate a crash: commit the next transaction to the WAL but apply only\n\t// every other page image.\n\tb.applyHook = func(id uint32) bool { return id%2 == 0 }\n\tif err := b.Put([]byte(\"crash-key\"), []byte(\"crash-val\")); err != nil {\n\t\tt.Fatal(err)\n\t}\n\toracle[\"crash-key\"] = \"crash-val\"\n\tb.applyHook = nil\n\n\tif err := wal.Recover(pager); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnap1 := dumpPager(pager)\n\t// Replay again: must be a no-op.\n\tif err := wal.Recover(pager); err != nil {\n\t\tt.Fatal(err)\n\t}\n\tsnap2 := dumpPager(pager)\n\tif !bytes.Equal(snap1, snap2) {\n\t\tt.Fatal(\"recovery is not idempotent\")\n\t}\n\n\t// Reopen and verify logical state against the oracle.\n\tb2, err := New(pager, wal)\n\tif err != nil {\n\t\tt.Fatal(err)\n\t}\n\tcheckAll(t, b2, oracle)\n}\n\n// ---- verification helpers ----\n\nfunc reachable(b *BTree) map[uint32]bool {\n\tseen := map[uint32]bool{}\n\tvar walk func(id uint32)\n\twalk = func(id uint32) {\n\t\tif seen[id] {\n\t\t\treturn\n\t\t}\n\t\tseen[id] = true\n\t\tp := b.load(id)\n\t\tif p.typ == pageTypeInterior {\n\t\t\twalk(p.leftmost)\n\t\t\tfor _, c := range p.cells {\n\t\t\t\twalk(c.child)\n\t\t\t}\n\t\t}\n\t}\n\twalk(b.root)\n\treturn seen\n}\n\nfunc dumpPager(p *MemPager) []byte {\n\tids := make([]int, 0, len(p.pages))\n\tfor id := range p.pages {\n\t\tids = append(ids, int(id))\n\t}\n\tsort.Ints(ids)\n\tvar out bytes.Buffer\n\tfor _, id := range ids {\n\t\tout.Write(p.pages[uint32(id)])\n\t}\n\treturn out.Bytes()\n}\n\nfunc checkAll(t *testing.T, b *BTree, oracle map[string]string) {\n\tt.Helper()\n\tcheckRawPages(t, b)\n\tleaves := checkOrderAndFill(t, b)\n\t// Oracle comparison over the leaf chain.\n\tgot := map[string]string{}\n\tfor _, kv := range leaves {\n\t\tgot[string(kv[0])] = string(kv[1])\n\t}\n\tif len(got) != len(oracle) {\n\t\tt.Fatalf(\"size mismatch: tree=%d oracle=%d\", len(got), len(oracle))\n\t}\n\tfor k, v := range oracle {\n\t\tif g, ok := got[k]; !ok || g != v {\n\t\t\tt.Fatalf(\"oracle mismatch for %q: got %q ok=%v want %q\", k, g, ok, v)\n\t\t}\n\t}\n\t// Scan must agree with the oracle and be ordered.\n\tvar prev []byte\n\tcount := 0\n\tb.Scan(func(k, v []byte) bool {\n\t\tif prev != nil && bytes.Compare(prev, k) >= 0 {\n\t\t\tt.Fatalf(\"scan out of order: %q >= %q\", prev, k)\n\t\t}\n\t\tprev = append([]byte(nil), k...)\n\t\tcount++\n\t\treturn true\n\t})\n\tif count != len(oracle) {\n\t\tt.Fatalf(\"scan count %d != oracle %d\", count, len(oracle))\n\t}\n}\n\n// checkRawPages verifies byte-level slotted-page invariants on every reachable\n// page: header consistency, slot bounds, no cell overlap, compaction and a\n// byte-exact serialize/deserialize round trip.\nfunc checkRawPages(t *testing.T, b *BTree) {\n\tt.Helper()\n\tfor id := range reachable(b) {\n\t\tbuf, err := b.pager.Read(id)\n\t\tif err != nil {\n\t\t\tt.Fatalf(\"read page %d: %v\", id, err)\n\t\t}\n\t\ttyp := buf[0]\n\t\tn := int(le.Uint16(buf[2:]))\n\t\tfreeStart := int(le.Uint16(buf[4:]))\n\t\tfreeEnd := int(le.Uint16(buf[6:]))\n\t\tif freeStart != headerSize+2*n {\n\t\t\tt.Fatalf(\"page %d: freeStart %d != header+2n %d\", id, freeStart, headerSize+2*n)\n\t\t}\n\t\tif freeEnd > PageSize || freeStart > freeEnd {\n\t\t\tt.Fatalf(\"page %d: bad free region [%d,%d)\", id, freeStart, freeEnd)\n\t\t}\n\t\ttype rng struct{ s, e int }\n\t\tvar rs []rng\n\t\tminOff := PageSize\n\t\tfor i := 0; i < n; i++ {\n\t\t\toff := int(le.Uint16(buf[headerSize+2*i:]))\n\t\t\tif off < freeEnd || off >= PageSize {\n\t\t\t\tt.Fatalf(\"page %d slot %d offset %d outside cell region [%d,%d)\", id, i, off, freeEnd, PageSize)\n\t\t\t}\n\t\t\tif off < minOff {\n\t\t\t\tminOff = off\n\t\t\t}\n\t\t\ts, e, err := rawCellBounds(buf, typ, i)\n\t\t\tif err != nil {\n\t\t\t\tt.Fatalf(\"page %d: %v\", id, err)\n\t\t\t}\n\t\t\trs = append(rs, rng{s, e})\n\t\t}\n\t\tif n > 0 && freeEnd != minOff {\n\t\t\tt.Fatalf(\"page %d not compacted: freeEnd %d minOffset %d\", id, freeEnd, minOff)\n\t\t}\n\t\tif n == 0 && freeEnd != PageSize {\n\t\t\tt.Fatalf(\"page %d empty but freeEnd %d\", id, freeEnd)\n\t\t}\n\t\tsort.Slice(rs, func(i, j int) bool { return rs[i].s < rs[j].s })\n\t\tfor i := 1; i < len(rs); i++ {\n\t\t\tif rs[i-1].e > rs[i].s {\n\t\t\t\tt.Fatalf(\"page %d cells overlap: [%d,%d) and [%d,%d)\", id, rs[i-1].s, rs[i-1].e, rs[i].s, rs[i].e)\n\t\t\t}\n\t\t}\n\t\tp := deserializePage(id, buf)\n\t\timg, ok := serializePage(p)\n\t\tif !ok {\n\t\t\tt.Fatalf(\"page %d does not re-serialize\", id)\n\t\t}\n\t\tif !bytes.Equal(buf, img) {\n\t\t\tt.Fatalf(\"page %d round-trip mismatch\", id)\n\t\t}\n\t}\n}\n\n// checkOrderAndFill recursively verifies key ordering and the minimum fill\n// invariant, and returns the leaf cells in order.\nfunc checkOrderAndFill(t *testing.T, b *BTree) [][2][]byte {\n\tt.Helper()\n\tvar leaves [][2][]byte\n\tvar walk func(id uint32, lo, hi []byte)\n\twalk = func(id uint32, lo, hi []byte) {\n\t\tp := b.load(id)\n\t\tif id != b.root && usedBytes(p) < minFill {\n\t\t\tt.Fatalf(\"page %d underflows: used=%d < minFill=%d\", id, usedBytes(p), minFill)\n\t\t}\n\t\tif p.typ == pageTypeLeaf {\n\t\t\tfor i, c := range p.cells {\n\t\t\t\tif i > 0 && bytes.Compare(p.cells[i-1].key, c.key) >= 0 {\n\t\t\t\t\tt.Fatalf(\"leaf %d keys not increasing\", id)\n\t\t\t\t}\n\t\t\t\tif lo != nil && bytes.Compare(c.key, lo) < 0 {\n\t\t\t\t\tt.Fatalf(\"leaf %d key %q below lower bound %q\", id, c.key, lo)\n\t\t\t\t}\n\t\t\t\tif hi != nil && bytes.Compare(c.key, hi) >= 0 {\n\t\t\t\t\tt.Fatalf(\"leaf %d key %q above upper bound %q\", id, c.key, hi)\n\t\t\t\t}\n\t\t\t\tleaves = append(leaves, [2][]byte{c.key, c.val})\n\t\t\t}\n\t\t\treturn\n\t\t}\n\t\tn := len(p.cells)\n\t\tfor j := 0; j <= n; j++ {\n\t\t\tl, h := lo, hi\n\t\t\tif j > 0 {\n\t\t\t\tl = maxKey(lo, p.cells[j-1].key)\n\t\t\t}\n\t\t\tif j < n {\n\t\t\t\th = minKey(hi, p.cells[j].key)\n\t\t\t}\n\t\t\twalk(childAt(p, j), l, h)\n\t\t}\n\t}\n\twalk(b.root, nil, nil)\n\treturn leaves\n}\n\nfunc maxKey(a, b []byte) []byte {\n\tif a == nil {\n\t\treturn b\n\t}\n\tif bytes.Compare(a, b) >= 0 {\n\t\treturn a\n\t}\n\treturn b\n}\n\nfunc minKey(a, b []byte) []byte {\n\tif a == nil {\n\t\treturn b\n\t}\n\tif bytes.Compare(a, b) <= 0 {\n\t\treturn a\n\t}\n\treturn b\n}\n```\n\n## 3. Verification\n\nBuild and run:\n\n```sh\ncd btree\ngo vet ./...\ngo test -count=1 -v ./...\ngo test -race -count=1 ./...\n```\n\nThe suite proves:\n\n1. **Oracle equivalence.** `TestRandomWorkload` (6000 ops, seed 42) and `TestManySeeds` (25 seeds × 4000 ops) apply random `Put`/`Delete` to the tree and a `map[string]string`, then compare every key/value and a full `Scan`.\n2. **Byte-level page invariants.** `checkRawPages` walks every reachable page and asserts: `freeStart == headerSize + 2*numSlots`; `freeStart <= freeEnd <= PageSize`; every slot offset lies in the cell region; no two cells overlap; `freeEnd` equals the minimum cell offset (slot-array compaction); and a byte-exact `deserialize`→`serialize` round trip. `checkOrderAndFill` additionally asserts sorted keys, correct separator bounds on every subtree, and `usedBytes >= minFill` for every non-root page.\n3. **Minimum fill factor.** The fill assertion runs after every checked operation, so every split and every delete-induced merge/redistribution keeps non-root pages above `PageSize/4`.\n4. **Crash recovery is idempotent.** `TestCrashRecoveryIdempotent` commits a transaction to the WAL but applies only every other page image (simulated crash mid-apply). It runs `WAL.Recover`, snapshots the pager, runs `Recover` again, and asserts byte-identical snapshots, then reopens the tree and re-checks oracle + invariants. Idempotency comes from full-page after-images plus the per-page LSN guard: an image is written only when the on-disk page LSN is strictly older.\n5. **Real on-disk storage.** `TestFilePagerRoundTrip` writes 500 entries through `FilePager`, closes and reopens the file, and re-verifies all invariants.\n\nObserved result:\n\n```text\n=== RUN   TestRandomWorkload\n    btree_test.go:58: final pages reachable: 202\n--- PASS: TestRandomWorkload (0.50s)\n=== RUN   TestManySeeds\n--- PASS: TestManySeeds (4.55s)\n=== RUN   TestLargeKeysAndValues\n--- PASS: TestLargeKeysAndValues (0.02s)\n=== RUN   TestFilePagerRoundTrip\n--- PASS: TestFilePagerRoundTrip (0.01s)\n=== RUN   TestCrashRecoveryIdempotent\n--- PASS: TestCrashRecoveryIdempotent (0.00s)\nPASS\nok  \tbtree\t5.077s\n```\n\n`go test -race -count=1 ./...` also passes.\n\n## 4. Summary of the fix\n\n| Defect | Symptom | Fix |\n| --- | --- | --- |\n| Fixed-median interior split ignores prefix compression | Right page overflows, or split point chosen to compensate underflows | `splitInterior` measures actual post-split serialized sizes and picks the best fitting, balanced pivot |\n| In-place value growth skipped the overflow check | Leaf exceeds `PageSize` after `Put` on existing key | Update path falls through to `fits`/`splitLeaf` |\n| Delete underflow | Near-empty pages after deletion | Merge when concatenation fits, otherwise exact byte-aware sibling redistribution; `usedBytes >= PageSize/4` asserted for all non-root pages |\n| Non-idempotent recovery | Replaying a committed txn twice | Full-page after-images plus per-page LSN guard in `WAL.Recover` |\n", "evidence": "# Evidence\n- Problem class: go-btree-slotted-page-split-varlen-underflow\n- Model: openrouter/deepseek/deepseek-v4.1-flash\n- Solved: 2026-11-02T11:02:34.754Z\n- Verification: solution produced by pi in sandbox; see signatures.json\n", "signatures": {"description": "Implement an on-disk B+tree with a slotted-page layout: variable-length keys, slot-array compaction, prefix-compressed interior keys, and atomic page splits that enforce a minimum fill factor. Leaf merges after delete must avoid underflow while keeping sibling redistribution exact, and crash-recovery must be idempotent via a redo record. Prove byte-level page invariants hold across a randomized workload of insert/delete/scan against a sorted-map oracle.", "environment": "go1.26", "language": "go", "model": "openrouter/deepseek/deepseek-v4.1-flash", "problem_class": "go-btree-slotted-page-split-varlen-underflow", "provider": "openrouter", "solved_at": "2026-11-02T11:02:34.754Z", "version": "1.26"}, "status": "verified", "created_at": "2026-11-02 11:02:35"}
++{"class_id": 3108, "class": "python3-fm-index-bwt-rank-select-backward-search", "title": "python3-fm-index-bwt-rank-select-backward-search", "description": "python3-fm-index-bwt-rank-select-backward-search", "answer_id": 4843, "language": "python", "environment": "python3", "version": "3.12", "solution": "# FM-Index over IUPAC Corpora with Wavelet-Tree Rank/Select — Diagnosis & Verified Solution\n\n## 1. Root-cause analysis\n\nThe problem class (\"FM-index + BWT + backward search + IUPAC + k-mismatch + sentinel/empty edge cases, validated against a naive oracle on repetitive inputs\") fails in practice for a small, well-known set of reasons. Each is fixed explicitly below.\n\n| # | Root cause | Symptom | Fix in this solution |\n|---|-----------|---------|----------------------|\n| 1 | **Sentinel handling.** The sentinel must be strictly smaller than every symbol, must live in the BWT, and the BWT wrap must read it for the suffix starting at position 0. | Last suffix's preceding char is wrong; C-array off by one; spurious matches at the empty suffix. | Append a dedicated id `0` smaller than all IUPAC ids; `bwt[i] = data[sa[i]-1]` with wrap to `data[-1]` (the sentinel). |\n| 2 | **Empty pattern.** Backward search initializes to `[0, n+1)` (includes the empty suffix). Naive scans produce offsets `0..n`. | Either `n` or `n+1` occurrences; mismatch with oracle. | Return the whole SA interval unchanged for `\"\"`, yielding exactly `len(text)+1` boundary offsets, matching the oracle. |\n| 3 | **`rank` half-open interval.** `rank(c, i)` must count `BWT[0:i]`, so `rank(c,0)=0`, `rank(c,n)=count(c)`. | `l/r` intervals shifted; dropped first/last occurrence. | Wavelet tree `rank` returns `0` for `i<=0` and counts strictly `[0,i)`. |\n| 4 | **`select` indexing.** Mixing 0/1-based ranks. | Wrong reconstruction of positions. | `select(sym,k)` takes `k` 1-based and returns a 0-based index; verified exhaustively. |\n| 5 | **IUPAC semantics treated as plain equality.** `N` should match `A/C/G/T`, `R` should match `A/G`, etc. | Greatly under-reported matches; k-mismatch counts wrong. | Matching is set-intersection: `IUPAC[q] & IUPAC[t]`. A union-of-SA-intervals search keeps all expansions without enumerating suffixes. |\n| 6 | **k-mismatch double counting / no pruning.** Branching over *all* symbols at every position, or counting matches as mismatches. | Duplicate offsets, exponential blow-up, wrong counts. | DFS spends the mismatch budget only on **non-intersecting** symbols; matched symbols are a separate cost-0 branch. Branches are pruned when their interval union is empty. |\n| 7 | **Repetitive inputs.** Naive suffix sorting degrades and ties are mishandled. | Wrong SA/BWT on `AAAA…`, `ATAT…`, runs, Fibonacci words. | Prefix-doubling SA with explicit class renumbering; fuzzed on adversarial repetitive corpora. |\n| 8 | **Interval set not merged.** Ambiguity creates several SA ranges per step; overlapping/adjacent ranges must be unioned. | Duplicate offsets, inflated counts. | `_merge_intervals` sorts and coalesces `[l,r)` ranges after every extension. |\n\n## 2. Exact fix — complete implementation\n\nSave as `fm_index.py`.\n\n```python\n\"\"\"FM-index over an IUPAC-aware alphabet with wavelet-tree rank/select.\"\"\"\n\nfrom bisect import bisect_left\n\n# --------------------------------------------------------------------------\n# Alphabet\n# --------------------------------------------------------------------------\nIUPAC = {\n    \"A\": frozenset(\"A\"), \"C\": frozenset(\"C\"), \"G\": frozenset(\"G\"),\n    \"T\": frozenset(\"T\"),\n    \"R\": frozenset(\"AG\"), \"Y\": frozenset(\"CT\"), \"S\": frozenset(\"CG\"),\n    \"W\": frozenset(\"AT\"), \"K\": frozenset(\"GT\"), \"M\": frozenset(\"AC\"),\n    \"B\": frozenset(\"CGT\"), \"D\": frozenset(\"AGT\"), \"H\": frozenset(\"ACT\"),\n    \"V\": frozenset(\"ACG\"), \"N\": frozenset(\"ACGT\"),\n}\nALPHABET = \"ACGTRYSWKMBDHVN\"\nSYMID = {c: i + 1 for i, c in enumerate(ALPHABET)}\nSENTINEL = 0\nSIGMA = len(ALPHABET) + 1          # symbols 0 .. SIGMA-1\nSYMSET = {SENTINEL: frozenset()}\nfor _c in ALPHABET:\n    SYMSET[SYMID[_c]] = IUPAC[_c]\n\n\ndef normalize(s: str) -> str:\n    return s.upper().replace(\"U\", \"T\")\n\n\n# --------------------------------------------------------------------------\n# Wavelet tree over integer symbols in [lo, hi]\n# --------------------------------------------------------------------------\nclass WaveletTree:\n    __slots__ = (\"lo\", \"hi\", \"n\", \"pref\", \"left\", \"right\")\n\n    def __init__(self, data, lo, hi):\n        self.lo, self.hi, self.n = lo, hi, len(data)\n        if lo == hi:\n            self.pref = self.left = self.right = None\n            return\n        mid = (lo + hi) >> 1\n        pref = [0] * (len(data) + 1)\n        left, right = [], []\n        for i, x in enumerate(data):\n            if x <= mid:\n                left.append(x); pref[i + 1] = pref[i] + 1\n            else:\n                right.append(x); pref[i + 1] = pref[i]\n        self.pref = pref\n        self.left = WaveletTree(left, lo, mid)\n        self.right = WaveletTree(right, mid + 1, hi)\n\n    def rank(self, sym: int, i: int) -> int:\n        \"\"\"Number of occurrences of ``sym`` in ``data[0:i]``.\"\"\"\n        if i <= 0:\n            return 0\n        if i > self.n:\n            i = self.n\n        node = self\n        while node.lo != node.hi:\n            mid = (node.lo + node.hi) >> 1\n            if sym <= mid:\n                i = node.pref[i]; node = node.left\n            else:\n                i = i - node.pref[i]; node = node.right\n        return i\n\n    def _map_left(self, ci: int) -> int:\n        return bisect_left(self.pref, ci + 1) - 1\n\n    def _map_right(self, ci: int) -> int:\n        j = ci + 1\n        lo, hi = 1, self.n\n        while lo < hi:\n            mid = (lo + hi) >> 1\n            if mid - self.pref[mid] >= j:\n                hi = mid\n            else:\n                lo = mid + 1\n        return lo - 1\n\n    def _select(self, sym: int, k: int) -> int:\n        if self.lo == self.hi:\n            return k - 1\n        mid = (self.lo + self.hi) >> 1\n        if sym <= mid:\n            ci = self.left._select(sym, k)\n            return -1 if ci < 0 else self._map_left(ci)\n        ci = self.right._select(sym, k)\n        return -1 if ci < 0 else self._map_right(ci)\n\n    def select(self, sym: int, k: int) -> int:\n        \"\"\"0-based position of the k-th (1-based) occurrence, or -1.\"\"\"\n        if k <= 0 or sym < self.lo or sym > self.hi:\n            return -1\n        if self.rank(sym, self.n) < k:\n            return -1\n        return self._select(sym, k)\n\n\n# --------------------------------------------------------------------------\n# Suffix array (prefix doubling)\n# --------------------------------------------------------------------------\ndef build_suffix_array(data):\n    n = len(data)\n    sa = list(range(n))\n    rank = list(data)\n    tmp = [0] * n\n    k = 1\n    while True:\n        sa.sort(key=lambda i: (rank[i], rank[i + k] if i + k < n else -1))\n        tmp[sa[0]] = 0\n        cls = 0\n        for idx in range(1, n):\n            a, b = sa[idx - 1], sa[idx]\n            if (rank[a], rank[a + k] if a + k < n else -1) != \\\n               (rank[b], rank[b + k] if b + k < n else -1):\n                cls += 1\n            tmp[b] = cls\n        rank, tmp = tmp, rank\n        if cls == n - 1:\n            break\n        k <<= 1\n    return sa\n\n\ndef _merge_intervals(intervals):\n    if not intervals:\n        return []\n    intervals = sorted(intervals)\n    out = [list(intervals[0])]\n    for l, r in intervals[1:]:\n        if l <= out[-1][1]:\n            if r > out[-1][1]:\n                out[-1][1] = r\n        else:\n            out.append([l, r])\n    return [(l, r) for l, r in out]\n\n\n# --------------------------------------------------------------------------\n# FM-index\n# --------------------------------------------------------------------------\nclass FMIndex:\n    def __init__(self, text: str, mode: str = \"iupac\"):\n        if mode not in (\"iupac\", \"exact\"):\n            raise ValueError(\"mode must be 'iupac' or 'exact'\")\n        self.mode = mode\n        self.text = normalize(text)\n        for ch in self.text:\n            if ch not in IUPAC:\n                raise ValueError(f\"bad corpus character {ch!r}\")\n        self.N = len(self.text)\n        self.syms = [SYMID[c] for c in self.text]\n        data = self.syms + [SENTINEL]\n        self.n_total = len(data)\n        self.sa = build_suffix_array(data)\n\n        # BWT[i] = data[sa[i]-1], wrapping to the sentinel at the end.\n        self.bwt = [data[pos - 1] if pos > 0 else data[-1] for pos in self.sa]\n        self.wt = WaveletTree(self.bwt, 0, SIGMA - 1)\n\n        counts = [0] * SIGMA\n        for x in data:\n            counts[x] += 1\n        C = [0] * (SIGMA + 1)\n        acc = 0\n        for s in range(SIGMA):\n            C[s] = acc\n            acc += counts[s]\n        C[SIGMA] = acc\n        self.C = C\n\n        self._match_ids, self._mismatch_ids = {}, {}\n        for ch in IUPAC:\n            if mode == \"exact\":\n                mid = [SYMID[ch]] if ch in SYMID else []\n            else:\n                qs = IUPAC[ch]\n                mid = [t for t in range(1, SIGMA) if SYMSET[t] & qs]\n            mis = [t for t in range(1, SIGMA) if t not in set(mid)]\n            self._match_ids[ch] = mid\n            self._mismatch_ids[ch] = mis\n\n    # -- helpers ----------------------------------------------------------\n    def _extend(self, intervals, sym_ids):\n        C, rank = self.C, self.wt.rank\n        out = []\n        ap = out.append\n        for l, r in intervals:\n            for t in sym_ids:\n                ll = C[t] + rank(t, l)\n                rr = C[t] + rank(t, r)\n                if ll < rr:\n                    ap((ll, rr))\n        return _merge_intervals(out)\n\n    def _ids_for(self, ch):\n        if ch not in IUPAC:\n            raise ValueError(f\"bad pattern character {ch!r}\")\n        return self._match_ids[ch], self._mismatch_ids[ch]\n\n    # -- public API -------------------------------------------------------\n    def exact_intervals(self, pattern: str):\n        \"\"\"Return the union of SA intervals matching ``pattern`` exactly.\"\"\"\n        p = normalize(pattern)\n        intervals = [(0, self.n_total)]\n        for ch in reversed(p):\n            mid, _ = self._ids_for(ch)\n            intervals = self._extend(intervals, mid)\n            if not intervals:\n                break\n        return intervals\n\n    def exact_occurrences(self, pattern: str):\n        return self._offsets(self.exact_intervals(pattern))\n\n    def _offset_lists(self, pattern: str, k: int):\n        p = normalize(pattern)\n        m = len(p)\n        results = []\n        match_ids = [self._ids_for(ch)[0] for ch in p]\n        mismatch_ids = [self._ids_for(ch)[1] for ch in p]\n\n        def dfs(i, cost, intervals):\n            if i < 0:\n                results.append(intervals)\n                return\n            if match_ids[i]:\n                nxt = self._extend(intervals, match_ids[i])\n                if nxt:\n                    dfs(i - 1, cost, nxt)\n            if cost < k and mismatch_ids[i]:\n                nxt = self._extend(intervals, mismatch_ids[i])\n                if nxt:\n                    dfs(i - 1, cost + 1, nxt)\n\n        dfs(m - 1, 0, [(0, self.n_total)])\n        return results\n\n    def kmismatch_intervals(self, pattern: str, k: int):\n        return self._offset_lists(pattern, k)\n\n    def kmismatch_occurrences(self, pattern: str, k: int):\n        res = []\n        for intervals in self._offset_lists(pattern, k):\n            res.extend(self._offsets(intervals))\n        return res\n\n    def _offsets(self, intervals):\n        res, sa = [], self.sa\n        for l, r in intervals:\n            res.extend(sa