andom.choice(['ebgp','ibgp']))\n            arr.append(('%d %s %s %s %s %s'%(ts,op,p,pf,nh,attrs),ts,i))\n        else:\n            arr.append(('%d %s %s %s'%(ts,op,p,pf),ts,i))\n    return arr\ndef reference(events):\n    live={}; wd={}\n    for line,ts,seq in sorted(events,key=lambda e:(e[1],e[2])):\n        f=line.split(); op=f[1]; p=f[2]; pf=f[3]; K=(p,pf)\n        if op=='A':\n            if K in wd and ts<=wd[K]: continue\n            if K in live and ts<live[K]['ts']: continue\n            if K in live and ts==live[K]['ts'] and live[K]['sig']>=line: continue\n            nh=f[4]; at={}\n            for tok in f[5:]:\n                k,v=tok.split('=',1); at[k]=v\n            live[K]=dict(peer=p,nh=nh,ts=ts,lp=int(at.get('localpref',100)),med=int(at.get('med',0)),\n                         as_=at.get('aspath',''),origin={'egp':1,'incomplete':2}.get(at.get('origin','igp'),0),\n                         pty=at.get('peer_type','ebgp'),w=int(at.get('weight',0)),sig=line)\n        else:\n            if K in live and live[K]['ts']>ts: continue\n            if K in live: del live[K]\n            wd[K]=ts\n    best={}\n    for (p,pf),a in live.items():\n        cand=dict(a); cand['pfx']=pf; cand['as']=a['as_']\n        if pf not in best or better(cand,best[pf]): best[pf]=cand\n    return {pf:b['nh'] for pf,b in best.items()}\nfails=0\nfor trial in range(40):\n    n=random.randint(0,40)\n    arr=gen(n)\n    txt='\\n'.join(e[0] for e in arr)+'\\n'\n    with tempfile.NamedTemporaryFile('w',suffix='.stream',delete=False) as fh:\n        fh.write(txt); path=fh.name\n    out=subprocess.run(['~/bgp-replay.sh','--window','100000','--emit-fib','/dev/stdout','--anomalies','/dev/null',path],capture_output=True,text=True)\n    got={}\n    for ln in out.stdout.splitlines():\n        if ln.strip(): parts=ln.split(); got[parts[0]]=parts[1]\n    exp=reference(arr)\n    if got!=exp:\n        fails+=1\n        print('MISMATCH trial',trial); print(txt); print('got',got); print('exp',exp