[]cell{{key: push, child: right}}}\n\t\tif err := t.stage(np); err != nil {\n\t\t\tt.abort()\n\t\t\treturn err\n\t\t}\n\t\tif err := t.stageMeta(nid); err != nil {\n\t\t\tt.abort()\n\t\t\treturn err\n\t\t}\n\t\tt.root = nid\n\t}\n\treturn t.commit()\n}\n\nfunc (t *BTree) put(pid uint32, key, val []byte) ([]byte, uint32, bool, error) {\n\tp := t.load(pid)\n\tif p.typ == pageTypeLeaf {\n\t\ti := sort.Search(len(p.cells), func(i int) bool {\n\t\t\treturn bytes.Compare(p.cells[i].key, key) >= 0\n\t\t})\n\t\tif i < len(p.cells) && bytes.Equal(p.cells[i].key, key) {\n\t\t\t// An in-place value update can enlarge a variable-length slab past\n\t\t\t// the page size; it must go through the same split path.\n\t\t\tp.cells[i].val = append([]byte(nil), val...)\n\t\t} else {\n\t\t\tp.cells = append(p.cells, cell{})\n\t\t\tcopy(p.cells[i+1:], p.cells[i:])\n\t\t\tp.cells[i] = cell{key: append([]byte(nil), key...), val: append([]byte(nil), val...)}\n\t\t}\n\t\tif fits(p) {\n\t\t\treturn nil, 0, false, t.stage(p)\n\t\t}\n\t\t_, right, err := t.splitLeaf(p)\n\t\tif err != nil {\n\t\t\treturn nil, 0, false, err\n\t\t}\n\t\treturn right.cells[0].key, right.id, true, nil\n\t}\n\n\tci := childIndexOf(p, key)\n\tpush, right, split, err := t.put(childAt(p, ci), key, val)\n\tif err != nil {\n\t\treturn nil, 0, false, err\n\t}\n\tif !split {\n\t\treturn nil, 0, false, nil\n\t}\n\tp.cells = append(p.cells, cell{})\n\tcopy(p.cells[ci+1:], p.cells[ci:])\n\tp.cells[ci] = cell{key: push, child: right}\n\tif fits(p) {\n\t\treturn nil, 0, false, t.stage(p)\n\t}\n\treturn t.splitInterior(p)\n}\n\n// splitLeaf splits an overflowing leaf into two leaves and links them. The two\n// writes belong to the same transaction as the parent update, so the split is\n// atomic from the point of view of recovery.\nfunc (t *BTree) splitLeaf(p *page) (*page, *page, error) {\n\tn := len(p.cells)\n\tif n < 2 {\n\t\treturn nil, nil, errKeyTooLarge\n\t}\n\tsizes := make([]int, n)\n\ttotal := 0\n\tfor i, c := range p.cells {\n\t\tsizes[i] = len(cellBytes(c, pageTypeLeaf, nil))\n\t\ttotal += sizes[i]\n\t}\n\tbest, bestDiff := 1, 1<<62\n\tlsum := 0\n\tfor i := 1; i < n; i++ {\n\t\tlsum += sizes[i-1]\n\t\tif d := abs(2*lsum - total); d < bestDiff {\n\t\t\tbestDiff, best = d, i\n\t\t}\n\t}\n\toldNext := p.next\n\tnid, err := t.pager.Alloc()\n\tif err != nil {\n\t\treturn nil, nil, err\n\t}\n\tleft := &page{id: p.id, typ: pageTypeLeaf, next: nid,\n\t\tcells: append([]cell(nil), p.cells[:best]...)}\n\tright := &page{id: nid, typ: pageTypeLeaf, next: oldNext,\n\t\tcells: append([]cell(nil), p.cells[best:]...)}\n\tif err := t.stage(left); err != nil {\n\t\treturn nil, nil, err\n\t}\n\tif err := t.stage(right); err != nil {\n\t\treturn nil, nil, err\n\t}\n\treturn left, right, nil\n}\n\n// splitInterior pushes a separator up to the parent. Prefix compression makes\n// the byte size of a cell depend on its predecessor, so removing the boundary\n// cell can make the right-hand page LARGER than it was. The pivot is therefore\n// chosen by measuring the actual serialized size of each candidate partition,\n// not by a fixed median. This is the core fix for the varlen split underflow /\n// overflow fault.\nfunc (t *BTree) splitInterior(p *page) ([]byte, uint32, bool, error) {\n\tn := len(p.cells)\n\tif n < 2 {\n\t\treturn nil, 0, false, errKeyTooLarge\n\t}\n\n\t// Prefix-compressed size of a run of interior cells standing alone.\n\trunSize := func(cells []cell) int {\n\t\tu := headerSize + 2*len(cells)\n\t\tvar prev []byte\n\t\tfor _, c := range cells {\n\t\t\tu += len(cellBytes(c, pageTypeInterior, prev))\n\t\t\tprev = c.key\n\t\t}\n\t\treturn u\n\t}\n\n\tbestMid := -1\n\tbestDiff := 1 << 62\n\tfor mid := 1; mid <= n-2; mid++ { // keep both sides non-empty\n\t\tls := runSize(p.cells[:mid])\n\t\trs := runSize(p.cells[mid+1:])\n\t\tif ls > PageSize || rs > PageSize {\n\t\t\tcontinue\n\t\t}\n\t\tif d := abs(ls - rs); d < bestDiff {\n\t\t\tbestDiff, bestMid = d, mid\n\t\t}\n\t}\n\tif bestMid < 0 {\n\t\t// No balanced pivot fits (pathologically large keys): pick any pivot\n\t\t// whose two sides each fit, even if one side is empty.\n\t\tfor mid := 0; mid <= n-1; mid++ {\n\t\t\tif runSize(p.cells[:mid]) <= PageSize && runSize(p.cells[mid+1:]) <= PageSize {\n\t\t\t\tbestMid = mid\n\t\t\t\tbreak\n\t\t\t}\n\t\t}\n\t}\n\tif bestMid < 0 {\n\t\treturn nil, 0, false, errKeyTooLarge\n\t}\n\tmid := bestMid\n\n\tpush := append([]byte(nil), p.cells[mid].key...)\n\tnid, err := t.pager.Alloc()\n\tif err != nil {\n\t\treturn nil, 0, false, err\n\t}\n\tright := &page{id: nid, typ: pageTypeInterior, leftmost: p.cells[mid].child,\n\t\tcells: append([]cell(nil), p.cells[mid+1:]...)}\n\tp.cells = p.cells[:mid]\n\t// p keeps its original leftmost.\n\tif !fits(p) || !fits(right) {\n\t\treturn nil, 0, false, errKeyTooLarge\n\t}\n\tif err := t.stage(p); err != nil {\n\t\treturn nil, 0, false, err\n\t}\n\tif err := t.stage(right); err != nil {\n\t\treturn nil, 0, false, err\n\t}\n\treturn push, nid, true, nil\n}\n\n// ---------------- Delete ----------------\n\nfunc (t *BTree) Delete(key []byte) error {\n\tif err := t.begin(); err != nil {\n\t\treturn err\n\t}\n\tdeleted, err := t.del(t.root, key)\n\tif err != nil {\n\t\tt.abort()\n\t\treturn err\n\t}\n\tif deleted {\n\t\troot := t.load(t.root)\n\t\tif root.typ == pageTypeInterior && len(root.cells) == 0 {\n\t\t\tif err := t.stageMeta(root.leftmost); err != nil {\n\t\t\t\tt.abort()\n\t\t\t\treturn err\n\t\t\t}\n\t\t\tt.root = root.leftmost\n\t\t}\n\t}\n\treturn t.commit()\n}\n\nfunc (t *BTree) del(pid uint32, key []byte) (bool, error) {\n\tp := t.load(pid)\n\tif p.typ == pageTypeLeaf {\n\t\ti := sort.Search(len(p.cells), func(i int) bool {\n\t\t\treturn bytes.Compare(p.cells[i].key, key) >= 0\n\t\t})\n\t\tif i >= len(p.cells) || !bytes.Equal(p.cells[i].key, key) {\n\t\t\treturn false, nil\n\t\t}\n\t\tp.cells = append(p.cells[:i], p.cells[i+1:]...)\n\t\treturn true, t.stage(p)\n\t}\n\tci := childIndexOf(p, key)\n\tdeleted, err := t.del