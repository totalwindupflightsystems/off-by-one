dom.Random(2)\n    for _ in range(50):\n        n = rnd.randrange(1, 30)\n        data = [rnd.randrange(0, 5) for _ in range(n)]\n        check(build_suffix_array(data) == sorted(range(n), key=lambda i: data[i:]), \"sa\")\n\nADV = {\"allA\": \"A\"*60, \"allN\": \"N\"*40, \"period2\": \"AT\"*40, \"period4\": \"ACGT\"*30,\n       \"runs\": \"A\"*8 + \"C\"*8 + \"G\"*8 + \"T\"*8 + \"N\"*8, \"ambiguous\": \"ARYSWKMBDHVN\"*8,\n       \"mixedN\": \"ANAN\"*20 + \"NNGG\", \"empty\": \"\", \"one\": \"A\"}\na, b = \"A\", \"AC\"\nwhile len(b) < 120: a, b = b, b + a\nADV[\"fibword\"] = b[:120]\n\ndef test_fm():\n    rnd = random.Random(3)\n    for name, text in ADV.items():\n        fm = FMIndex(text)\n        pats = [\"\", \"A\", \"N\", \"AC\", \"ACGT\", \"AN\", \"NA\", \"ARYS\", \"NNNN\", \"TTTTT\",\n                text[:5], text[-5:]]\n        for _ in range(40):\n            m = rnd.randrange(0, min(8, len(text)) + 1)\n            start = rnd.randrange(0, len(text) - m + 1) if m <= len(text) else 0\n            s = list(text[start:start + m])\n            for j in range(len(s)):\n                if rnd.random() < 0.2: s[j] = rnd.choice(\"ACGTRYSWKMBDHVN\")\n            pats.append(\"\".join(s))\n        for pat in pats:\n            check(sorted(fm.exact_occurrences(pat)) == naive_occurrences(text, pat, 0),\n                  f\"exact [{name}] {pat!r}\")\n            for k in (1, 2):\n                check(sorted(fm.kmismatch_occurrences(pat, k)) == naive_occurrences(text, pat, k),\n                      f\"k={k} [{name}] {pat!r}\")\n\ndef test_edges():\n    fm = FMIndex(\"ACGT\")\n    check(sorted(fm.exact_occurrences(\"\")) == [0, 1, 2, 3, 4], \"empty\")\n    check(4 not in fm.exact_occurrences(\"A\"), \"sentinel leak\")\n    check(fm.exact_occurrences(\"ACGTAC\") == [], \"too long\")\n    check(sorted(FMIndex(\"ACGT\").exact_occurrences(\"N\")) == [0, 1, 2, 3], \"N wildcard\")\n    check(sorted(FMIndex(\"ANN\").exact_occurrences(\"A\")) == [0, 1, 2], \"A vs ANN\")\n    c