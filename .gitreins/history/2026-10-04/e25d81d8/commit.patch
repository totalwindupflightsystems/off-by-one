+	if snap.OverBudget != 1 {
+		t.Errorf("OverBudget = %d, want 1", snap.OverBudget)
+	}
+	if snap.PeakRSSBytesMax != 5<<30 {
+		t.Errorf("PeakRSSBytesMax = %d, want %d", snap.PeakRSSBytesMax, 5<<30)
+	}
