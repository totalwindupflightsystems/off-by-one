eys: MAX_KEYS });\n  const reference = new BPlusTree({\n    maxKeys: MAX_KEYS,\n    truncateSeparators: false,\n    requireMinimalSeparators: false,\n  });\n  const oracle = new Map();\n\n  const counts = { insert: 0, delete: 0, get: 0, range: 0 };\n\n  for (let i = 0; i < OPS; i++) {\n    const key = pool[randInt(pool.length)];\n    const hx = keySignature(key);\n    const x = rnd();\n\n    if (x < 0.55) {\n      const value = val(`v:${i}:${randInt(1e9)}`);\n      compressed.insert(key, value);\n      reference.insert(key, value);\n      oracle.set(hx, value);\n      counts.insert++;\n    } else if (x < 0.77) {\n      const a = compressed.delete(key);\n      const b = reference.delete(key);\n      const c = oracle.delete(hx);\n      assert.strictEqual(a, b, `delete return mismatch at op ${i}`);\n      assert.strictEqual(a, c, `oracle delete return mismatch at op ${i}`);\n      counts.delete++;\n    } else if (x < 0.93) {\n      const gc = compressed.get(key);\n      const gr = reference.get(key);\n      const go = oracle.get(hx);\n      assert.strictEqual(gc === undefined, gr === undefined, `get presence mismatch at op ${i}`);\n      if (gc !== undefined) {\n        assert(gc.equals(gr), `get value mismatch tree/tree at op ${i}`);\n        assert(gc.equals(go), `get value mismatch tree/oracle at op ${i}`);\n      }\n      counts.get++;\n    } else {\n      let start = pool[randInt(pool.length)];\n      let end = pool[randInt(pool.length)];\n      if (compareBytes(start, end) > 0) [start, end] = [end, start];\n      const includeEnd = rnd() < 0.5;\n      const rc = compressed.range(start, end, { includeEnd });\n      const rr = reference.range(start, end, { includeEnd });\n      samePairs(rc, rr, `range tree/tree at op ${i}`);\n\n      const ro = sortedOracleEntries(oracle).filter(([k]) => {\n        if (compareBytes(k, start) < 0) return false;\n        const c = compareBytes(k, end);\n        return includeEnd ? c <= 0 : c < 0;\n      });\n      samePairs(rc, ro, `range tree/oracle at op ${i}`);\n      counts.range++;\n    }\n\n    if ((i + 1) % 1000 === 0) {\n      const throughCodec = (i + 1) % 10000 === 0;\n      checkAll(compressed, reference, oracle, throughCodec, `checkpoint ${i + 1}`);\n      if (VERBOSE) {\n        console.log(\n          `  ${i + 1}: size=${compressed.size} height=${height(compressed)}` +\n            (throughCodec ? ' [codec round-trip]' : '')\n        );\n      }\n    }\n  }\n\n  checkAll(compressed, reference, oracle, true, 'final');\n  console.log('  counts:', counts);\n  console.log(`  final size: ${compressed.size}, height: ${height(compressed)}`);\n  console.log(`PASS: ${OPS} differential fuzz`);\n}\n\nfunction height(tree) {\n  let h = 1;\n  let n = tree.root;\n  while (!n.leaf) {\n    h++;\n    n = n.children[0];\n  }\n  return h;\n}\n\ntry {\n  main();\n} catch (err) {\n  console.error('FAIL:', err && err.stack ? err.stack : err);\n  process.exitCode = 1;\n}\n```\n\n---\n\n## Verification\n\nRun the 100k-operation differential fuzz:\n\n```bash\nmkdir -p btree-solution\ncd btree-solution\n# save the two files above as btree.js and fuzz.js\nnode fuzz.js\n```\n\nVerified result:\n\n```text\nB+tree differential fuzz: 100000 operations, maxKeys=8\n  all-equal-prefix sentinel separator is strict and minimal\n  codec rejects reconstructed duplicate/out-of-order keys\n  counts: { insert: 54938, delete: 21907, get: 16050, range: 7105 }\n  final size: 3004, height: 5\nPASS: 100000 differential fuzz\n```\n\nAdditional split/merge stress across small and large page capacities:\n\n```bash\nfor k in 3 4 5 16; do\n  OPS=20000 MAX_KEYS=$k node fuzz.js\ndone\n```\n\nEach run passes with the same logical dataset and different tree heights, confirming that leaf splits, internal splits, borrows, merges, root collapse, sibling links, rightmost flags, and minimal separators remain correct.\n", "evidence": "# Evidence\n- Problem class: node20-btree-suffix-truncation-minimal-separator-split\n- Model: openrouter/deepseek/deepseek-v4.1-flash\n- Solved: 2026-10-24T22:09:06.954Z\n- Verification: solution produced by pi in sandbox; see signatures.json\n", "signatures": {"description": "Implement a B+tree key codec with shared prefix compression plus suffix truncation, where every internal separator is stored as the shortest key satisfying last_key(left) < separator <= first_key(right), with a page-level prefix length and a per-key truncation length. Your split path must derive a legal minimal separator (including the all-equal-prefix case, which needs an appended sentinel byte and must stay strictly above the left page's last key), then repair sibling pointers and the rightmost-page flag when the split target is the rightmost leaf or the root. Add decode-side validation that rejects pages whose reconstructed ordering violates the truncated-separator invariant, and a fuzz harness that diffs the compressed tree against an uncompressed reference tree across 100k randomized insert/delete/point-lookup/range-scan operations.", "environment": "node20", "language": "js", "model": "openrouter/deepseek/deepseek-v4.1-flash", "problem_class": "node20-btree-suffix-truncation-minimal-separator-split", "provider": "openrouter", "solved_at": "2026-10-24T22:09:06.954Z", "version": "20"}, "status": "verified", "created_at": "2026-10-24 22:09:06"}
+{"class_id": 2972, "class": "bash-tcp-zero-window-persist-timer-backoff-audit", "title": "bash-tcp-zero-window-persist-timer-backoff-audit", "description": "bash-tcp-zero-window-persist-timer-backoff-audit", "answer_id": 4704, "language": "shell", "environment": "bash", "version": "5.2", "solution": "## Done\n\n**Deliverable:** `~/work/SOLUTION.md` — self-contained, with the exact script, the test harness, and verification evidence.\n\n### Root cause\nThe trace is not a flat event list but **two interleaved directional state machines**: `R→S` segments advertise `R`'s window to sender `S`, while `S→R` segments are sender activity. A naive one-pass check cannot separate:\n- genuine **stall** (two consecutive zero adverts, no probe after),\n- a **lost window update recovered by retransmission** (probe is legitimate),\n- a **spurious probe** after the window genuinely reopened,\n- **full data** retransmitted into a closed window,\n- **backoff/rate** violations (must double, cap 60 s, ≤2 probes/5 s).\n\nIt also commonly mislabels the reopen as the *first* update instead of the last one the sender actually received, and uses integer math that truncates sub-second gaps.\n\n### The fix\n`tcp_persist_audit.sh` (bash 5.2 + awk for float math):\n1. Groups packets by unordered endpoint pair; audits each ordered direction independently.\n2. Buffers a **zero-window episode** (ZEROs / UPDATEs / PROBEs / DATA) and classifies with look-ahead.\n3. Derives the schedule `exp_gap = min(prev_gap*2, 60)`, flagging both too-slow and too-fast gaps, plus the 5 s/2-probe rate rule.\n4. Excuses probes when the peer re-advertises the open window (lost-update recovery) and uses the **last** update as the effective reopen for the stalled duration.\n5. Emits per-connection verdicts (first stall entry, every backoff shift, reopen time, total stalled) and `exit 1` on any violation, `2` on usage error.\n\n### Verification\n- **9/9** regression traces pass (`./run_tests.sh`): healthy, spurious+full-data, stall, lost-update recovery, backoff+rate, 60 s cap breach, cap saturation, multi-connection, CSV input.\n- `shellcheck tcp_persist_audit.sh run_tests.sh` → clean.\n- The script embedded in `SOLUTION.md` was diffed against the tested file (`EMBEDDED SCRIPT MATCHES TESTED FILE`) and the embedded harness re-run independently (9/9).\n", "evidence": "# Evidence\n- Problem class: bash-tcp-zero-window-persist-timer-backoff-audit\n- Model: openrouter/deepseek/deepseek-v4.1-flash\n- Solved: 2026-10-24T22:13:04.890Z\n- Verification: solution produced by pi in sandbox; see signatures.json\n", "signatures": {"description": "Given a text packet trace (timestamp, src, dst, seq, ack, flags, advertised window, payload length), reconstruct per-connection sender and receiver state and audit RFC 1122 zero-window handling: detect entry into persist mode, derive the exponential probe backoff (RTO for the first probe, then doubling, capped at 60s, never more than two probes inside any 5s window), and flag probes sent while the window had already reopened (spurious) versus probes never sent after two consecutive zero-window advertisements (stall). Distinguish a genuine zero-window stall from a window-update segment that was lost and recovered by the peer's retransmission, and from a sender wrongly retransmitting full data segments into a zero window instead of probing. Emit per-connection verdicts with the timestamp of first stall entry, every backoff shift, total stalled duration, and exit nonzero when any connection violates the probe schedule.", "environment": "bash", "language": "shell", "model": "openrouter/deepseek/deepseek-v4.1-flash", "problem_class": "bash-tcp-zero-window-persist-timer-backoff-audit", "provider": "openrouter", "solved_at": "2026-10-24T22:13:04.890Z", "version": "5.2"}, "status": "verified", "created_at": "2026-10-24 22:13:07"}
+{"class_id": 2973, "class": "go-test-package-timeout-within-package", "title": "go-test-package-timeout-within-package", "description": "go-test-package-timeout-within-package", "answer_id": 4705, "language": "go", "environment": "docker", "version": "latest", "solution": "Solution written to `~/SOLUTION.md` and verified by running both the broken and fixed trees. Here is the document:\n\n---\n\n# INT-CI-014: `cmd/server` 60s package timeout caused by a test paying the production webhook-retry budget\n\n**Repo:** `<project>-dev/<project>`\n**Broken HEAD:** `bedc7cb`\n**Fix commit:** `dd9b96e`\n**Evidence file:** `cmd/server/session_dispatch_test.go`\n\n## 1. Summary\n\n`make test` is `go test ./... -count=1 -timeout 60s -p 1`. `-p 1` serializes packages, so this is not cross-package contention — `cmd/server` exceeds its own 60s deadline. One of three long tests, `TestSessionFanoutWebhookFailureIsRefused`, spent ~30s waiting on the production default `CR_SESSION_DELIVERY_TIMEOUT_MS` (30000ms) while asserting only the final refusal outcome. The fix points that test at the existing config seam with the smallest budget that still exercises retry + classification, and adds regression gates. ~30s is removed, but two independent policy-shaped blockers remain.\n\n## 2. Root-cause analysis\n\n**Timeout stack** (`go test ./cmd/server/ -count=1 -timeout 60s`) panics at the package deadline and names the *other* long test, which is why the raw stack misleads:\n\n```\npanic: test timed out after 1m0s\n\trunning tests:\n\t\tTestDocsClaimsBehaviors (29s)\n...\nos/exec.(*Cmd).CombinedOutput(...)\n\t~/<project>/cmd/server/docsclaims_hooks_test.go:38\ncmd/server.liveBehavior(...)\n\t~/<project>/cmd/server/docsclaims_hooks_test.go:38\ncmd/server.TestDocsClaimsBehaviors.func1(...)\n\t~/<project>/cmd/server/docsclaims_hooks_test.go:90\n```\n\nPer-test measurement of the broken tree (`-v`, 276 top-level tests):\n\n| Test | Broken `bedc7cb` | Fixed `dd9b96e` |\n|---|---:|---:|\n| `TestDocsClaimsBehaviors` | 51.69s | 47.49s |\n| **`TestSessionFanoutWebhookFailureIsRefused`** | **30.07s** | **2.06s** |\n| `TestDocsClaims` | 11.77s | 11.50s |\n| package wall clock | **157.126s** | **121.014s** |\n\n**Why the 30s:** the test registers a *blocking* webhook with a 500 response. `internal/webhook/webhook.go` classifies 5xx as `Retryable: true`; `internal/webhook/driver.go` retries with `backoff(n)` = 1s, 2s, 4s, 8s, 16s (capped) until the delivery budget expires. Default budget is `registry.DefaultSessionDeliveryTimeoutMs = 30000`. The test asserted `outcome == \"refused\"`, no reply row, `skipped == 1` — none of which depend on the budget's magnitude.\n\n**The seam already exists** in `config/config.go`: `CR_SESSION_DELIVERY_TIMEOUT_MS` (1..30000, default 30000) and `RUNTIME_TIMEOUT_MS` (1..25000, default 20000, must be strictly less than delivery). Since `backoff(1) == 1s`, the smallest budget that shows a retry is just over 1s; the fix uses 2000ms / 1500ms.\n\n## 3. Exact fix\n\nOnly `cmd/server/session_dispatch_test.go` changes: add a `sessionDispatchFixtureAtRootWithEnv` variant (caller keys win), set `CR_SESSION_DELIVERY_TIMEOUT_MS=2000` / `RUNTIME_TIMEOUT_MS=1500`, and add wall-clock + attempt-count assertions. The full patch is embedded in `~/SOLUTION.md`; the core of it:\n\n```go\nfunc sessionDispatchFixtureAtRootWithEnv(t *testing.T, hook http.Handler, verdict, logRoot string, extra map[string]string) (...) {\n\t...\n\tenv := map[string]string{\n\t\t\"CR_SESSION_BACKEND\": \"jsonl\", \"CR_SESSION_LOG_ROOT\": logRoot,\n\t\t\"CR_REQUIRE_AGENT_SIG\": \"false\",\n\t\t\"CR_GROUP_LOG_ROOT\":    t.TempDir(), \"CR_GUARD_ENABLED\": \"true\", \"SESSION_GUARD_TEST_KEY\": \"test-key\",\n\t}\n\tfor k, v := range extra { // caller-supplied keys win\n\t\tenv[k] = v\n\t}\n\tbase := startTestServerWithEnv(t, env)\n\t...\n}\n\nfunc TestSessionFanoutWebhookFailureIsRefused(t *testing.T) {\n\tconst (\n\t\tsessionBudget = 2000\n\t\truntimeBudget = 1500\n\t\twallCeiling   = 10 * time.Second\n\t)\n\tfor _, status := range []int{http.StatusBadRequest, http.StatusInternalServerError} {\n\t\tt.Run(http.StatusText(status), func(t *testing.T) {\n\t\t\t...\n\t\t\tbase, room, _, envelopes := sessionDispatchFixtureAtRootWithEnv(t, hook, \"allow\", root, map[string]string{\n\t\t\t\t\"CR_SESSION_DELIVERY_TIMEOUT_MS\": strconv.Itoa(sessionBudget),\n\t\t\t\t\"RUNTIME_TIMEOUT_MS\":             strconv.Itoa(runtimeBudget),\n\t\t\t})\n\t\t\tstarted := time.Now()\n\t\t\tmsg := sendDispatchMessage(t, base, room)\n\t\t\telapsed := time.Since(started)\n\t\t\t... existing outcome assertions ...\n\t\t\trequire.Less(t, elapsed, wallCeiling,\n\t\t\t\t\"a failed blocking webhook took %s against a %dms budget: the delivery budget must bound this wait\", elapsed, sessionBudget)\n\t\t\tattempts := 0\n\t\t\tfor { select { case <-envelopes: attempts++; continue; default: } break }\n\t\t\tif status == http.StatusInternalServerError {\n\t\t\t\trequire.Greater(t, attempts, 1, \"a 5xx is retryable: the blocking delivery must retry inside its budget (attempts=%d)\", attempts)\n\t\t\t} else {\n\t\t\t\trequire.Equal(t, 1, attempts, \"a non-retryable 4xx must not be retried (attempts=%d)\", attempts)\n\t\t\t}\n\t\t})\n\t}\n}\n```\n\nApply with `git checkout dd9b96e -- cmd/server/session_dispatch_test.go`.\n\n## 4. Verification\n\n**Green (fixed):**\n```\n--- PASS: TestSessionFanoutWebhookFailureIsRefused (2.07s)\n    --- PASS: .../Bad_Request (0.03s)\n    --- PASS: .../Internal_Server_Error (2.03s)\nok  github.com/<project>-dev/<project>/cmd/server  2.120s\n```\n\n**Before vs after (same command):** `30.06s` (5 attempts, 30s budget) → `2.06s` (2 attempts, 2s budget).\n\n**Full package:** `157.126s` → `121.014s`.\n\n**Gates red-proven then green:**\n- Restore default budget → `\"30.002589382s\" is not less than \"10s\"` … `the delivery budget must bound this wait`, FAIL in 30.03s.\n- Budget below first backoff (`500ms`) → `\"1\" is not greater than \"1\"` … `must retry inside its budget (attempts=1)`, FAIL in 0.53s.\n\n**Remaining independent blockers:** on the fixed tree `go test ./cmd/server/ -count=1 -timeout 60s` still panics at 60s on `TestDocsClaimsBehaviors` (docsclaims_hooks_test.go:38, `make doctor-hooks-selftest`). Excluding both docs-claims tests: `go test -count=1 -timeout 300s -skip 'TestDocsClaims' ./cmd/server/` → `ok ... 62.241s`, still over 60s. These are policy-shaped (parallelize the idle-bound suite, split out integration-shaped tests, or widen the per-package budget) and need an owner decision.\n\n## 5. Takeaway\n\nA test that asserts an outcome should not inherit a production retry budget it never checks. State the budget at the existing seam (2000ms/1500ms), keep the production retry/classify/refuse path, and assert wall clock plus attempt count so a regression reds instead of silently eating half the package deadline.\n", "evidence": "# Evidence\n- Problem class: go-test-package-timeout-within-package\n- Model: openrouter/deepseek/deepseek-v4.1-flash\n- Solved: 2026-10-24T22:24:37.777Z\n- Verification: solution produced by pi in sandbox; see signatures.json\n", "signatures": {"description": "A Go package can exceed a 60s test deadline because one test waits on a production-default retry budget even though it asserts only the final refusal outcome. Measure the timeout stack and per-test duration; override the existing config seam to the smallest budget that still exercises retry/classification, and add wall-clock plus retry-count regression assertions. This can remove one long test but may leave other independent package blockers requiring a separate owner decision.", "environment": "", "language": "go", "model": "openrouter/deepseek/deepseek-v4.1-flash", "problem_class": "go-test-package-timeout-within-package", "provider": "openrouter", "solved_at": "2026-10-24T22:24:37.777Z", "version": ""}, "status": "verified", "created_at": "2026-10-24 22:24:37"}
