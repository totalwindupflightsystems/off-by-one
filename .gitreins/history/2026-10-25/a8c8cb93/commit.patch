Map + sorted key projection, catches bugs shared by the trees\n */\n\nconst assert = require('assert');\nconst {\n  BPlusTree,\n  Page,\n  encodePage,\n  decodePage,\n  minimalSeparator,\n  compareBytes,\n  CodecError,\n} = require('./btree');\n\nconst OPS = Number(process.env.OPS || 100000);\nconst MAX_KEYS = Number(process.env.MAX_KEYS || 8);\nconst VERBOSE = process.env.VERBOSE === '1';\n\nfunction mulberry32(a) {\n  return function () {\n    a |= 0;\n    a = (a + 0x6d2b79f5) | 0;\n    let t = Math.imul(a ^ (a >>> 15), 1 | a);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\nconst rnd = mulberry32(0x51ed270b);\nconst randInt = (n) => Math.floor(rnd() * n);\n\nfunction val(s) {\n  return Buffer.from(s, 'utf8');\n}\n\n// Deliberately create many prefix relationships, including keys that are\n// prefixes of other keys and keys differing only after a long common prefix.\nlet serial = 0;\nfunction freshKey() {\n  const n = serial++;\n  const base = (n % 4096).toString(36).padStart(4, '0');\n  const variant = n % 11;\n  const prefixes = ['', 'a', 'aa', 'a\\u0000', 'prefix-', 'prefix-\\u0000'];\n  const suffixes = ['', '\\u0000', '\\u0000\\u0000', 'z', '\\u00ff', '-tail'];\n  const p = prefixes[(n >>> 4) % prefixes.length];\n  const s = suffixes[variant % suffixes.length];\n  return Buffer.concat([\n    Buffer.from(p, 'latin1'),\n    Buffer.from(base, 'latin1'),\n    Buffer.from(s, 'latin1'),\n  ]);\n}\n\nconst pool = [];\nfor (let i = 0; i < 3500; i++) pool.push(freshKey());\nfor (let i = 0; i < 700; i++) pool.push(freshKey());\n\nfunction keySignature(k) {\n  return k.toString('hex');\n}\n\nfunction sortedOracleEntries(oracle) {\n  return Array.from(oracle.entries())\n    .map(([hex, value]) => [Buffer.from(hex, 'hex'), value])\n    .sort((a, b) => compareBytes(a[0], b[0]));\n}\n\nfunction samePairs(a, b, label) {\n  assert.strictEqual(a.length, b.length, `${label}: length`);\n  for (let i = 0; i < a.length; i++) {\n    assert(a[i][0].equals(b[i][0]), `${label}: key at ${i}`);\n    assert(a[i][1].equals(b[i][1]), `${label}: value at ${i}`);\n  }\n}\n\nfunction checkAll(compressed, reference, oracle, throughCodec, where) {\n  compressed.validate({ throughCodec });\n  reference.validate();\n\n  assert.strictEqual(compressed.size, reference.size, `${where}: size`);\n  assert.strictEqual(compressed.size, oracle.size, `${where}: oracle size`);\n\n  const c = compressed.entries();\n  const r = reference.entries();\n  const o = sortedOracleEntries(oracle);\n  samePairs(c, r, `${where}: compressed vs uncompressed tree`);\n  samePairs(c, o, `${where}: compressed vs oracle`);\n}\n\nfunction testCodecRejectsBadOrdering() {\n  const p = new Page(true, true);\n  p.keys = [Buffer.from('dup'), Buffer.from('dup')];\n  p.values = [Buffer.from('1'), Buffer.from('2')];\n  const buf = encodePage(p);\n  assert.throws(() => decodePage(buf), (e) => e instanceof CodecError);\n  console.log('  codec rejects reconstructed duplicate/out-of-order keys');\n}\n\nfunction testSentinelCase() {\n  const left = Buffer.from('abc');\n  const right = Buffer.from('abcd');\n  const sep = minimalSeparator(left, right);\n  assert(compareBytes(left, sep) < 0);\n  assert(compareBytes(sep, right) <= 0);\n  assert(sep.equals(Buffer.from('abc\\u0000', 'latin1')));\n  assert(!(compareBytes(sep.subarray(0, sep.length - 1), left) > 0));\n  console.log('  all-equal-prefix sentinel separator is strict and minimal');\n}\n\nfunction main() {\n  console.log(`B+tree differential fuzz: ${OPS} operations, maxKeys=${MAX_KEYS}`);\n  testSentinelCase();\n  testCodecRejectsBadOrdering();\n\n  const compressed = new BPlusTree({ maxKeys: MAX_KEYS });\n  const reference = new BPlusTree({\n    maxKeys: MAX_KEYS,\n    truncateSeparators: false,\n    requireMinimalSeparators: false,\n  });\n  const oracle = new Map();\n\n  const counts = { insert: 0, delete: 0, get: 0, range: 0 };\n\n  for (let i = 0; i < OPS; i++) {\n    const key = pool[randInt(pool.length)];\n    const hx = keySignature(key);\n    const x = rnd();\n\n    if (x < 0.55) {\n      const value = val(`v:${i}:${randInt(1e9)}`);\n      compressed.insert(key, value);\n      reference.insert(key, value);\n      oracle.set(hx, value);\n      counts.insert++;\n    } else if (x < 0.77) {\n      const a = compressed.delete(key);\n      const b = reference.delete(key);\n      const c = oracle.delete(hx);\n      assert.strictEqual(a, b, `delete return mismatch at op ${i}`);\n      assert.strictEqual(a, c, `oracle delete return mismatch at op ${i}`);\n      counts.delete++;\n    } else if (x < 0.93) {\n      const gc = compressed.get(key);\n      const gr = reference.get(key);\n      const go = oracle.get(hx);\n      assert.strictEqual(gc === undefined, gr === undefined, `get presence mismatch at op ${i}`);\n      if (gc !== undefined) {\n        assert(gc.equals(gr), `get value mismatch tree/tree at op ${i}`);\n        assert(gc.equals(go), `get value mismatch tree/oracle at op ${i}`);\n      }\n      counts.get++;\n    } else {\n      let start = pool[randInt(pool.length)];\n      let end = pool[randInt(pool.length)];\n      if (compareBytes(start, end) > 0) [start, end] = [end, start];\n      const includeEnd = rnd() < 0.5;\n      const rc = compressed.range(start, end, { includeEnd });\n      const rr = reference.range(start, end, { includeEnd });\n      samePairs(rc, rr, `range tree/tree at op ${i}`);\n\n      const ro = sortedOracleEntries(oracle).filter(([k]) => {\n        if (compareBytes(k, start) < 0) return false;\n        const c = compareBytes(k, end);\n        return includeEnd ? c <= 0 : c < 0;\n      });\n      samePairs(rc, ro, `range tree/oracle at op ${i}`);\n      counts.range++;\n    }\n\n    if ((i + 1) % 1000 === 0) {\n      const throughCodec = (i + 1) % 10000 === 0;\n      checkAll(compressed, reference, oracle, throughCodec, `checkpoint ${i + 1}`);\n      if (VERBOSE) {\n        console.log(\n          `  ${i + 1