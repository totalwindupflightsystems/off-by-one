index 00000000..1ab72843
--- /dev/null
+++ b/scripts/hooks/pre-commit
@@ -0,0 +1,86 @@
+#!/usr/bin/env bash
+# Repo-local pre-commit hook — tracked source of truth (DF-OFF-BY-ONE-55).
+# Installed into the repo's hooks directory by scripts/install-hooks.sh.
+#
+# Two gates run on every commit; BOTH statuses propagate — a failure of
+# either rejects the commit:
+#
+#   1. GitReins guard (tier 1) — skipped cleanly when the repo carries no
+#      .gitreins/config.yaml. The guard body runs in a subshell so a bare
+#      `exit` inside it cannot skip board-lint; its status is captured and
+#      re-exited after board-lint.
+#
+#   2. board-lint — FAIL-CLOSED validation of the JSONL board under
+#      .coding-hermes/board: duplicate task ids and dangling depends_on
+#      reject the commit, and the validator output names the offending id.
+#      A missing board dir, a missing boardctl binary, a missing timeout(1),
+#      or a validator timeout (rc 124) SKIP the gate: board-lint must never
+#      wedge commits on tooling problems, only on board-validation failures.
+#
+# This file is tracked so a fresh clone can install the enforcing hook via
+# `make install-hooks` (scripts/install-hooks.sh); the copy under
+# .git/hooks is generated, never edited by hand.
+
+gitreins_guard_status=0
+(
+# GitReins pre-commit guard — tier-1 checks on the staged change.
+REPO_ROOT="$(git rev-parse --show-toplevel)"
+if [ ! -f "$REPO_ROOT/.gitreins/config.yaml" ]; then
+    exit 0
+fi
+
+cd "$REPO_ROOT"
+gitreins guard
+exit $?
+) || gitreins_guard_status=$?
+
+# >>> boardctl board-lint managed block (source: scripts/hooks/pre-commit) >>>
+boardctl_timeout=30
+boardctl_lint_mode="fail"
+boardctl_lint_status=0
+boardctl_lint_main() {
+	# board-lint: reject commits that break the JSONL board
+	# (duplicate ids; dangling depends_on via --fail-on dangling-dep).
+	board_root="$(git rev-parse --show-toplevel)"
+	if [ ! -d "$board_root/.coding-hermes/board" ]; then
+		return 0
+	fi
+	if command -v boardctl >/dev/null 2>&1; then
+		lint_bin="$(command -v boardctl)"
+	else
+		echo "board-lint: skipped (boardctl binary not found)" >&2
+		return 0
+	fi
+	if ! command -v timeout >/dev/null 2>&1; then
+		echo "board-lint: skipped (timeout(1) unavailable)" >&2
+		return 0
+	fi
+	lint_out="$(timeout "$boardctl_timeout" "$lint_bin" validate -C "$board_root" --fail-on dangling-dep 2>&1)"
+	lint_rc=$?
+	case "$lint_rc" in
+		0)
+			return 0
+			;;
+		124)
+			echo "board-lint: skipped (timeout)" >&2
+			return 0
+			;;
+		2)
+			echo "board-lint: skipped (no board found under $board_root)" >&2
+			return 0
+			;;
+		*)
+			# mode=fail: a validation error (e.g. duplicate task id —
+			# the validator output below names it) rejects the commit.
+			echo "board-lint: commit rejected (boardctl validate failed, mode=$boardctl_lint_mode)" >&2
+			echo "$lint_out" >&2
+			return 1
+			;;
+	esac
+}
+# <<< boardctl board-lint managed block <<<
+boardctl_lint_main || boardctl_lint_status=$?
+if [ "$boardctl_lint_status" -ne 0 ]; then
+	exit "$boardctl_lint_status"
+fi
+exit "$gitreins_guard_status"
diff --git a/scripts/install-hooks.sh b/scripts/install-hooks.sh
new file mode 100755
index 00000000..6783bb9a
--- /dev/null
+++ b/scripts/install-hooks.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+# scripts/install-hooks.sh — install this repo's tracked hooks
+# (scripts/hooks/*) into the hooks directory git ACTUALLY consults for this
+# checkout (DF-OFF-BY-ONE-55).
+#
+# Why this exists: a core.hooksPath set at global/system scope (e.g. a
+# fleet-wide hooks dir) makes git ignore $GIT_DIR/hooks entirely — a hook
+# installed only there is inert. This installer
+#   1. installs scripts/hooks/pre-commit into the repo's OWN hooks dir
+#      (resolved via `git rev-parse --git-common-dir`, so it is also correct
+#      from a linked worktree), and
+#   2. when core.hooksPath is in effect and resolves somewhere else, sets a
+#      REPO-LOCAL core.hooksPath pointing at the repo's hooks dir so git
+#      consults it. Only this repo's .git/config is written; global/user
+#      config and any foreign hooks dir are never modified.
+#
+# Idempotent; safe to re-run. A differing pre-existing pre-commit hook is
+# backed up next to the target before being replaced.
+#
+# Usage: bash scripts/install-hooks.sh   (or: make install-hooks)
+
+set -euo pipefail
+
+repo_root="$(git rev-parse --show-toplevel)"
+common_dir="$(git rev-parse --git-common-dir)"
+case "$common_dir" in
+	/*) : ;;
+	*)  common_dir="$repo_root/$common_dir" ;;
+esac
+hooks_dir="${common_dir%/}/hooks"
+
+src="$repo_root/scripts/hooks/pre-commit"
+dst="$hooks_dir/pre-commit"
+[ -f "$src" ] || { echo "install-hooks: missing tracked source $src" >&2; exit 1; }
+
+mkdir -p "$hooks_dir"
+if [ -f "$dst" ] && ! cmp -s "$src" "$dst"; then
+	backup="$dst.bak-$(date -u +%Y%m%dT%H%M%SZ)"
+	cp -p "$dst" "$backup"
+	echo "install-hooks: existing pre-commit differed; backed up to $backup"
+fi
+install -m 0755 "$src" "$dst"
+echo "install-hooks: installed $dst"
+
+# If core.hooksPath (any scope) currently steers git away from the repo's own
+# hooks dir, counter it with a repo-local override.
+configured="$(git config --get core.hooksPath || true)"
+resolved="$(git rev-parse --git-path hooks)"
+case "$resolved" in
+	/*) : ;;
+	*)  resolved="$repo_root/$resolved" ;;
+esac
+resolved="${resolved%/}"
+if [ -n "$configured" ] && [ "$resolved" != "$hooks_dir" ]; then
+	git config core.hooksPath "$hooks_dir"
+	echo "install-hooks: core.hooksPath was '$configured' (non-local scope); set repo-local core.hooksPath=$hooks_dir"
+fi
+
+echo "install-hooks: git resolves pre-commit to $(git rev-parse --git-path hooks/pre-commit)"
