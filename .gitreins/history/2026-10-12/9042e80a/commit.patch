+func TestExport_NonBareTargetOtherBranchAllowed(t *testing.T) {
+	skipIfNoGit(t)
+	setGitIdentity(t)
+	store, pc, answer := makeStore(t)
+
+	target := initWorkRepo(t, "main") // main is checked out; we push "export"
+	localDir := filepath.Join(t.TempDir(), "clone")
+	e := NewEngine(Config{
+		RepoURL:  target,
+		Branch:   "export",
+		LocalDir: localDir,
+		Push:     true,
