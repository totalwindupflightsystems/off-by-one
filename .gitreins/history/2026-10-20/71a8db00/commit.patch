@@ -0,0 +1,33 @@
+commit 7bd02be5dd6fd03a11f38cad02cfb13db8ce87ca
+Author:     totalwindupflightsystems <totalwindupflightsystems@gmail.com>
+AuthorDate: Tue Oct 20 03:51:09 2026 -0500
+Commit:     totalwindupflightsystems <totalwindupflightsystems@gmail.com>
+CommitDate: Tue Oct 20 03:51:09 2026 -0500
+
+    fix: drop Makefile from check-binary-fresh code-path filter
+    
+    check-binary-fresh diffs code paths against the stamped revision to tolerate
+    data-only commits. Makefile was in the filter, so a Makefile-only edit forced
+    the byte comparison which always differs due to the embedded version stamp.
+    Dropping Makefile from the filter lets it pass when only it changed.
+    
+    Fixes OB-GAP-094.
+    
+    Co-authored-by: Alexis Okuwa <wojonstech@gmail.com>
+---
+ Makefile | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/Makefile b/Makefile
+index 51d00551..870e4414 100644
+--- a/Makefile
++++ b/Makefile
+@@ -63,7 +63,7 @@ check-binary-fresh:
+ 	if git rev-parse --verify --quiet "$$candidate^{commit}" >/dev/null 2>&1; then \
+ 		resolved=yes; \
+ 		rev=$$(git rev-parse --short "$$candidate"); \
+-		changed=$$(git diff --name-only "$$rev" -- cmd/ internal/ web/ sql/ pkg/ go.mod go.sum Makefile); \
++		changed=$$(git diff --name-only "$$rev" -- cmd/ internal/ web/ sql/ pkg/ go.mod go.sum); \
+ 		if [ -z "$$changed" ]; then \
+ 			echo "./$(BINARY) is up to date with source (version stamp changed, but code paths are unchanged)"; \
+ 			exit 0; \
