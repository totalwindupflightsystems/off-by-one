diff --git a/pkg/api/openapi.yaml b/pkg/api/openapi.yaml
index f7784907..bf59ac96 100644
--- a/pkg/api/openapi.yaml
+++ b/pkg/api/openapi.yaml
@@ -807,6 +807,10 @@ components:
       properties:
         commit_sha:
           type: string
+        action:
+          type: string
+          enum: [exported, noop]
+          description: What this export call actually did. "exported" means new content was committed and pushed to the target (commit_sha is non-empty) — this includes a re-export that recovered and pushed a previously stranded unpushed commit. "noop" means the request succeeded but the rendered answers were already identical to what the target holds, so nothing was committed or pushed (commit_sha is then empty and files_changed still counts the re-rendered files). Consumers must read action, not commit_sha emptiness, to distinguish a real export from an idempotent re-export.
         pr_url:
           type: string
           description: Reserved for future pull-request creation and never populated by the current implementation. There is no pull-request creation code path, so no export response ever carries a PR URL; the field is kept in the schema only for backward compatibility and is always omitted.
