+{
+  "class_id": 1915,
+  "title": "go-mu-calculus-alternating-fixpoint-model-checker",
+  "description": "go-mu-calculus-alternating-fixpoint-model-checker",
+  "created_at": "2026-09-18 10:24:17",
+  "answers": [
