in bump cannot strand the docs again).\nAcceptance: the version in the recipe satisfies `go.mod`; `GOTOOLCHAIN=local` build succeeds with the\nrecipe's toolchain.", "capability_tags": [], "created_by": null, "created_at": "2026-10-16 11:54:39Z", "updated_at": "2026-10-16 11:54:39Z", "worker_status": "complete", "attempts": 0, "exit_code": null, "commit_hash": "229d436f", "files_changed": [], "lines_added": 0, "lines_removed": 0, "guard_result": null, "ci_result": null, "worker_summary": null, "foreman_note": "Wave recovery 2026-10-17: commit 229d436f already on master (merged by prior tick but board not updated). Verified via git log.", "blocked_reason": null, "review_notes": null, "completed_at": null, "blocked_since": null, "detail": {"fingerprint": "69cce664d3dfcebca7468d54006e384107daf26ae9abc3ffc2e7770d19804ccd", "evidence": [{"run_id": "dogfood-20261016-readme-toolchain-below-gomod-minimum", "ts": "2026-10-16 11:54:39Z"}]}}
