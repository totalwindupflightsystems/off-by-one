    fix(import): preserve embedded horizontal rules in sections
    
    extractSection treated the first "\n---\n" after a section header as a
    section boundary, truncating solution bodies that embed a horizontal
    rule. Section parsing now cuts only at real following headings
    ("\n## " / "\n# "); rule lines within a section are retained.
    Regression test TestExtractSection_EmbeddedHorizontalRule fails on the
    pre-change implementation and passes with the fix.
    
    Addresses DF-OFF-BY-ONE-23
    
    Co-authored-by: Alexis Okuwa <wojonstech@gmail.com>
---
 internal/import/git.go      |  6 ++++--
 internal/import/git_test.go | 17 +++++++++++++++++
 2 files changed, 21 insertions(+), 2 deletions(-)

diff --git a/internal/import/git.go b/internal/import/git.go
index c9fe057..08a139e 100644
--- a/internal/import/git.go
+++ b/internal/import/git.go
@@ -566,8 +566,10 @@ func extractSection(content, marker string) string {
 	rest := content[idx+len(marker):]
 	// Skip the trailing newline(s) after the marker.
 	rest = strings.TrimLeft(rest, "\n\r ")
-	// If there's another section after this one, cut at it.
-	for _, nextMarker := range []string{"\n---\n", "\n## ", "\n# "} {
+	// If there's another section after this one, cut at it. The section
+	// ends only at the next heading; horizontal-rule lines ("---") inside
+	// the section are content, not boundaries.
+	for _, nextMarker := range []string{"\n## ", "\n# "} {
 		if cutIdx := strings.Index(rest, nextMarker); cutIdx >= 0 && cutIdx < len(rest) {
 			candidate := strings.TrimSpace(rest[:cutIdx])
 			if candidate != "" {
