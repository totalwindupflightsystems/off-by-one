# DeepSeek API key for Pi Agent solving
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# OpenRouter key for the default solver lane. Also read by the experimental
# DS-003 embeddings package, which is not wired into any serving path —
# optional, no runtime effect on the served API.
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
